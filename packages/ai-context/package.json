{
  "name": "@repo/ai-context",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "pnpm exec eslint .",
    "format": "prettier --write --log-level silent .",
    "format:check": "prettier --check .",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run format:check"
  },
  "exports": {
    ".": "./src/index.ts",
    "./storage": "./src/storage/index.ts",
    "./permissions": "./src/permissions.ts",
    "./grounded-chat-record-ref": "./src/grounded-chat-record-ref.ts"
  },
  "dependencies": {
    "@repo/entities": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "@repo/theme": "workspace:*",
    "@repo/ui-builder-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
