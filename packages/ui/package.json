{
  "name": "@repo/ui",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write --log-level silent .",
    "format:check": "prettier --check .",
    "lint:unused": "knip --no-progress",
    "lint:circular": "echo \"Skipping circular check for ui package\"",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run format:check && pnpm run lint:unused",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:visual:install": "playwright install chromium",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "dependencies": {
    "@repo/theme": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-essentials": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "serve": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.3.5",
    "vitest": "catalog:"
  }
}
