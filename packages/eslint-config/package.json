{
  "name": "@repo/eslint-config",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write --log-level silent .",
    "format:check": "prettier --check .",
    "lint:unused": "knip --no-progress",
    "lint:circular": "echo \"Skipping circular check for config-only package\"",
    "validate": "pnpm run format:check && pnpm run lint:unused"
  },
  "exports": {
    "./base": "./base.js",
    "./react": "./react.js",
    "./ui-primitives": "./ui-primitives.js"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
