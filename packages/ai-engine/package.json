{
  "name": "@repo/ai-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "pnpm exec eslint .",
    "format": "prettier --write --log-level silent .",
    "format:check": "prettier --check .",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run format:check"
  },
  "exports": {
    ".": "./src/index.ts",
    "./permissions": {
      "types": "./src/permissions.ts",
      "default": "./dist/permissions.js"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    },
    "./process-ai-chat": "./src/process-ai-chat.ts",
    "./task-routes": {
      "types": "./src/task-routes.ts",
      "default": "./dist/task-routes.js"
    },
    "./vertex-ai.client": "./src/vertex-ai.client.ts"
  },
  "dependencies": {
    "@google-cloud/vertexai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
