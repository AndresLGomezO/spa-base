{
  "name": "@repo/ai-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "pnpm exec eslint .",
    "format": "prettier --write --log-level silent .",
    "format:check": "prettier --check .",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run format:check"
  },
  "exports": {
    ".": "./src/index.ts",
    "./permissions": "./src/permissions.ts",
    "./schemas": "./src/schemas/index.ts",
    "./sanitize-ai-job-persistence": "./src/sanitize-ai-job-persistence.ts",
    "./controller": "./src/controller/index.ts",
    "./process-ai-ui-builder": "./src/process-ai-ui-builder.ts",
    "./task-routes": "./src/task-routes.ts",
    "./vertex-ai.client": "./src/vertex-ai.client.ts",
    "./vertex-mock-responses": "./src/vertex-mock-responses.ts",
    "./text-embedding": "./src/text-embedding.ts",
    "./extract-json-from-model-answer": "./src/extract-json-from-model-answer.ts",
    "./ui-builder-output-prompts": "./src/ui-builder-output-prompts.ts",
    "./parse-ui-builder-list-suggestion": "./src/parse-ui-builder-list-suggestion.ts",
    "./normalize-ai-list-slice-suggestion": "./src/normalize-ai-list-slice-suggestion.ts",
    "./ui-builder-orchestrator": "./src/ui-builder-orchestrator/index.ts",
    "./grounded-chat": "./src/grounded-chat/index.ts",
    "./grounded-chat/refresh-user-ai-memory": "./src/grounded-chat/refresh-user-ai-memory.ts",
    "./model-router": "./src/model-router.ts",
    "./observability": "./src/observability/index.ts",
    "./record-ai-summary": "./src/record-ai-summary/index.ts",
    "./spend": "./src/spend/index.ts"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "catalog:",
    "@google-cloud/vertexai": "catalog:",
    "@google/genai": "catalog:",
    "@repo/ai-context": "workspace:*",
    "@repo/entities": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "@repo/ui-builder-core": "workspace:*",
    "google-auth-library": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui-builder-core": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
