{
  "name": "@repo/gcp-firebase",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "pnpm exec eslint .",
    "format": "prettier --write --log-level silent .",
    "format:check": "prettier --check .",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run format:check"
