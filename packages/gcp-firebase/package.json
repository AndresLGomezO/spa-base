  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./auth": "./src/auth.ts",
    "./app-check": "./src/app-check.ts",
    "./firebase-admin": "./src/firebase-admin.ts",
    "./firestore-admin-user-repository": "./src/firestore-admin-user-repository.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
