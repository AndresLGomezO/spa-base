    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@google-cloud/firestore": "catalog:",
    "@repo/dynamic-entities": "workspace:*",
    "@repo/entities": "workspace:*",
    "@repo/firestore-indexes": "workspace:*",
    "@repo/firestore-converters": "workspace:*",
    "@repo/hooks": "workspace:*",
    "@repo/query-engine": "workspace:*",
    "@repo/rbac": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "firebase-admin": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  }
