{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-workspace.yaml",
    "prettier.config.mjs",
    "knip.json",
    "packages/eslint-config/**",
    "packages/typescript-config/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["//#format:root"],
      "cache": false
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"],
      "outputs": [],
      "cache": false
    },
    "prettier": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "cypress": {
      "dependsOn": ["build"],
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "test:visual": {
      "dependsOn": ["build-storybook"],
      "cache": false
    },
    "lint:unused": {
      "dependsOn": ["^build"],
      "inputs": ["**/*", "package.json", "knip.json"],
      "outputs": [],
      "cache": false
    },
    "lint:circular": {
      "dependsOn": ["^build"],
      "inputs": ["**/*", "tsconfig*.json", "package.json"],
      "outputs": [],
      "cache": false
    },
    "i18n:validate": {
      "inputs": [
        "scripts/validate-i18n.mjs",
        "app/i18n/locales/**/*.json",
        "app/**/*.ts",
        "app/**/*.tsx",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "//#format:root": {
      "cache": false
    },
    "//#format:check:root": {
      "inputs": [
        "*.{json,md,js,yml,yaml,mjs}",
        "turbo.json",
        "pnpm-workspace.yaml",
        "prettier.config.mjs",
        "knip.json"
      ],
      "outputs": [],
      "cache": false
    }
  }
}
