{
  "name": "project-base",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "format:check:root": "prettier --check --no-error-on-unmatched-pattern \"*.{json,md,js,yml,yaml,mjs}\" \"packages/**/*.{json,js,mjs}\" \"apps/**/*.{json,js,ts,mjs}\" \".github/**/*.{yml,md}\"",
    "format:root": "prettier --write --no-error-on-unmatched-pattern \"*.{json,md,js,yml,yaml,mjs}\" \"packages/**/*.{json,js,mjs}\" \"apps/**/*.{json,js,ts,mjs}\" \".github/**/*.{yml,md}\"",
    "prettier": "turbo run prettier",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "cypress": "turbo run cypress",
    "lint:unused": "turbo run lint:unused",
    "lint:circular": "turbo run lint:circular",
    "lint:duplicates": "tsx scripts/find-duplicates.ts",
    "lint:duplicates:json": "tsx scripts/find-duplicates.ts --json",
    "lint:deps": "syncpack lint",
    "lint:deps:fix": "syncpack fix",
    "lint:static": "pnpm run lint:unused && pnpm run lint:circular",
    "validate": "tsx scripts/validate.ts",
    "validate:ci": "tsx scripts/validate.ts --ci",
    "emulators:prepare": "pnpm --filter web build",
    "emulators": "pnpm run emulators:prepare && firebase emulators:start --only auth,firestore,storage,hosting --project demo-project-base",
    "emulators:docker": "pnpm run emulators:prepare && docker compose -f docker-compose.dev.yml up firebase-emulator --force-recreate"
  },
  "devDependencies": {
    "firebase-tools": "catalog:",
    "knip": "catalog:",
    "madge": "catalog:",
    "prettier": "catalog:",
    "ts-morph": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "syncpack": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "esbuild"
    ]
  }
}
