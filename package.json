{
  "name": "project-base",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format --output-logs=errors-only && pnpm terraform:fmt",
    "format:check": "turbo run format:check && pnpm terraform:fmt:check",
    "terraform:fmt": "cd packages/infrastructure/terraform && terraform fmt -recursive",
    "terraform:fmt:check": "cd packages/infrastructure/terraform && terraform fmt -check -recursive",
    "format:check:root": "prettier --check --no-error-on-unmatched-pattern \"*.{json,md,js,yml,yaml,mjs}\" \"packages/**/*.{json,js,mjs,ts,md}\" \"apps/**/*.{json,js,ts,mjs,md}\" \".github/**/*.{yml,md}\"",
    "format:root": "prettier --write --log-level silent --no-error-on-unmatched-pattern \"*.{json,md,js,yml,yaml,mjs}\" \"packages/**/*.{json,js,mjs,ts,md}\" \"apps/**/*.{json,js,ts,mjs,md}\" \".github/**/*.{yml,md}\"",
    "prettier": "turbo run prettier",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "cypress": "turbo run cypress",
    "lint:unused": "turbo run lint:unused",
    "lint:circular": "turbo run lint:circular",
    "lint:duplicates": "tsx scripts/find-duplicates.ts",
    "lint:duplicates:json": "tsx scripts/find-duplicates.ts --json",
    "lint:deps": "syncpack lint",
    "lint:deps:fix": "syncpack fix",
    "lint:static": "pnpm run lint:unused && pnpm run lint:circular",
    "i18n:validate": "pnpm --filter web run i18n:validate",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook",
    "test:visual:install": "pnpm --filter @repo/ui test:visual:install",
    "test:visual": "pnpm --filter @repo/ui test:visual",
    "test:visual:update": "bash scripts/update-visual-snapshots-linux.sh",
    "firestore:doc": "tsx scripts/firestore-doc-manager/firestore-doc.ts",
    "entity:api": "tsx scripts/firestore-doc-manager/entity-api.ts",
    "generate:firestore-indexes": "tsx scripts/generate-firestore-indexes.ts",
    "generate:ai-context": "tsx scripts/generate-ai-context.ts",
    "prune:firestore-indexes": "tsx scripts/prune-all-firestore-composite-indexes.ts",
    "check:firestore-indexes": "tsx scripts/generate-firestore-indexes.ts && git diff --exit-code firestore.indexes.json",
    "check:ai-context": "tsx scripts/generate-ai-context.ts && git diff --exit-code packages/ai-context/src/generated/",
    "check:docker-workspace": "tsx scripts/check-docker-workspace.ts",
    "check:prod-runtime": "node scripts/check-prod-runtime.mjs",
    "validate": "tsx scripts/validate.ts",
    "validate:ci": "tsx scripts/validate.ts --ci",
    "validate:local": "pnpm format && pnpm validate:ci",
    "precommit": "pnpm i18n:validate -- --strict && pnpm terraform:fmt:check && pnpm validate:ci",
    "emulators:prepare": "pnpm --filter web build",
    "emulators": "pnpm run emulators:prepare && firebase emulators:start --only auth,firestore,storage,hosting,pubsub --project demo-project-base",
    "emulators:docker": "pnpm run emulators:prepare && docker compose -f docker-compose.dev.yml up firebase-emulator --force-recreate",
    "dev:docker": "pnpm run emulators:prepare && docker compose -f docker-compose.dev.yml up --build pubsub-init firebase-emulator api worker-aggregation web",
    "dev:docker:reset": "tsx scripts/docker-dev-reset.ts",
    "seed:database": "tsx --env-file=apps/api/.env.dev apps/api/src/scripts/seed-database.ts",
    "docker:prune": "bash scripts/docker-prune-all.sh"
  },
  "devDependencies": {
    "@repo/ai-context": "workspace:*",
    "@repo/dynamic-entities": "workspace:*",
    "@repo/entities": "workspace:*",
    "@repo/firestore-indexes": "workspace:*",
    "@repo/gcp-firebase": "workspace:*",
    "firebase-tools": "catalog:",
    "knip": "catalog:",
    "madge": "catalog:",
    "nanoid": "catalog:",
    "prettier": "catalog:",
    "syncpack": "catalog:",
    "ts-morph": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "esbuild"
    ]
  }
}
