{
  "name": "project-base",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format --output-logs=errors-only",
    "format:check": "turbo run format:check",
    "format:check:root": "prettier --check --no-error-on-unmatched-pattern \"*.{json,md,js,yml,yaml,mjs}\" \"packages/**/*.{json,js,mjs,ts}\" \"apps/**/*.{json,js,ts,mjs}\" \".github/**/*.{yml,md}\"",
    "format:root": "prettier --write --log-level silent --no-error-on-unmatched-pattern \"*.{json,md,js,yml,yaml,mjs}\" \"packages/**/*.{json,js,mjs,ts}\" \"apps/**/*.{json,js,ts,mjs}\" \".github/**/*.{yml,md}\"",
    "prettier": "turbo run prettier",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "cypress": "turbo run cypress",
    "lint:unused": "turbo run lint:unused",
    "lint:circular": "turbo run lint:circular",
    "lint:duplicates": "tsx scripts/find-duplicates.ts",
    "lint:duplicates:json": "tsx scripts/find-duplicates.ts --json",
    "lint:deps": "syncpack lint",
    "lint:deps:fix": "syncpack fix",
    "lint:static": "pnpm run lint:unused && pnpm run lint:circular",
    "i18n:validate": "pnpm --filter web run i18n:validate",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook",
    "test:visual:install": "pnpm --filter @repo/ui test:visual:install",
    "test:visual": "pnpm --filter @repo/ui test:visual",
    "test:visual:update": "pnpm --filter @repo/ui test:visual:update",
    "test:visual:update:ci": "bash scripts/update-visual-snapshots-linux.sh",
    "validate": "tsx scripts/validate.ts",
    "validate:ci": "tsx scripts/validate.ts --ci",
    "emulators:prepare": "pnpm --filter web build",
    "emulators": "pnpm run emulators:prepare && firebase emulators:start --only auth,firestore,storage,hosting --project demo-project-base",
    "emulators:docker": "pnpm run emulators:prepare && docker compose -f docker-compose.dev.yml up firebase-emulator --force-recreate",
    "dev:docker": "pnpm run emulators:prepare && docker compose -f docker-compose.dev.yml up --build firebase-emulator api web",
    "dev:docker:reset": "docker compose -f docker-compose.dev.yml down -v --rmi all --remove-orphans && docker builder prune -af && docker compose -f docker-compose.dev.yml up -d --force-recreate --build"
  },
  "devDependencies": {
    "firebase-tools": "catalog:",
    "knip": "catalog:",
    "madge": "catalog:",
    "nanoid": "catalog:",
    "prettier": "catalog:",
    "syncpack": "catalog:",
    "ts-morph": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "esbuild"
    ]
  }
}
