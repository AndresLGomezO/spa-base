{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/fix-service-worker.mjs",
    "preview": "vite preview --outDir build/client --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write --log-level silent .",
    "format:check": "prettier --check .",
    "prettier": "prettier --check .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint:unused": "knip --no-progress",
    "lint:circular": "node ../../scripts/lint-circular.mjs --circular --ts-config tsconfig.madge.json --extensions ts,tsx app/",
    "i18n:validate": "node scripts/validate-i18n.mjs",
    "cypress": "start-server-and-test 'pnpm preview' http://localhost:4173 'env -u ELECTRON_RUN_AS_NODE pnpm exec cypress run'",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@app/platform": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@repo/ai-context": "workspace:*",
    "@repo/data-view": "workspace:*",
    "@repo/theme": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/dynamic-entities": "workspace:*",
    "@repo/entities": "workspace:*",
    "@repo/formula-definitions": "workspace:*",
    "@repo/gmail-ingest": "workspace:*",
    "@repo/hooks": "workspace:*",
    "@repo/firestore-indexes": "workspace:*",
    "@repo/modules": "workspace:*",
    "@repo/chart-definitions": "workspace:*",
    "@repo/custom-views": "workspace:*",
    "@repo/entity-queries": "workspace:*",
    "@repo/metrics-engine": "workspace:*",
    "@repo/query-engine": "workspace:*",
    "@repo/rbac": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "@repo/tenant-bundle": "workspace:*",
    "@repo/ui-builder": "workspace:*",
    "@repo/ui-builder-core": "workspace:*",
    "@repo/ui-builder-react": "workspace:*",
    "@repo/ui-builder-renderer": "workspace:*",
    "@repo/ui-charts": "workspace:*",
    "@repo/workload-registry": "workspace:*",
    "@react-router/node": "catalog:",
    "firebase": "catalog:",
    "isbot": "catalog:",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "workbox-window": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@react-router/dev": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "cypress": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "start-server-and-test": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "workbox-core": "catalog:",
    "workbox-precaching": "catalog:",
    "workbox-routing": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true,
        "skipAsyncImports": true
      },
      "tsx": {
        "skipTypeImports": true,
        "skipAsyncImports": true
      }
    }
  }
}
