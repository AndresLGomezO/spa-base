{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write --log-level silent .",
    "format:check": "prettier --check .",
    "prettier": "prettier --check .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint:unused": "knip --no-progress",
    "lint:circular": "madge --circular --ts-config tsconfig.madge.json --extensions ts,tsx app/",
    "i18n:validate": "node scripts/validate-i18n.mjs",
    "cypress": "start-server-and-test 'pnpm preview' http://localhost:4173 'env -u ELECTRON_RUN_AS_NODE pnpm exec cypress run'",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@repo/theme": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "@react-router/node": "catalog:",
    "firebase": "catalog:",
    "isbot": "catalog:",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@react-router/dev": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "cypress": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "madge": "catalog:",
    "prettier": "catalog:",
    "start-server-and-test": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true,
        "skipAsyncImports": true
      },
      "tsx": {
        "skipTypeImports": true,
        "skipAsyncImports": true
      }
    }
  }
}
