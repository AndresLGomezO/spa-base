VITE_ENV=dev

# Firebase web config (local emulator defaults)
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-project-base
VITE_FIREBASE_STORAGE_BUCKET=demo-project-base.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
# Web Push certificate key from Firebase Console → Cloud Messaging → Web Push certificates.
# VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_AUTH_EMULATOR_DISABLE_WARNINGS=true

# Browser must use published host ports (127.0.0.1), not Docker service names.
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# API base URL (user registration via GET /auth/validate)
VITE_API_URL=http://127.0.0.1:3000