                      },
                      {
                        "property": "width",
                        "value": "100%"
                      },
                      {
                        "property": "height",
                        "value": "100%"
                      },
                      {
                        "property": "borderRadius",
                        "value": "var(--radius-lg)"
                      },
                      {
