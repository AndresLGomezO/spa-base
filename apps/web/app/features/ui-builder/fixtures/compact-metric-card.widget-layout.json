                          "dimensionBindings": {
                            "date": {
                              "type": "dashboardDateFilter"
                            }
                          },
                          "styles": [
                            {
                              "property": "marginTop",
                              "value": "10"
                            },
                            {
                              "property": "fontSize",
                              "value": "20"
                            },
                            {
                              "property": "fontWeight",
                              "value": "bold"
                            },
                            {
                              "property": "letterSpacing",
                              "value": "-0.025em"
                            },
                            {
                              "property": "color",
                              "value": "var(--color-card-foreground)"
                            }
                          ]
                        }
                      },
                      {
                        "type": "component",
                        "id": "row-income-period",
                        "component": {
                          "kind": "text",
                          "primary": {
                            "type": "static",
                            "value": "This month"
                          },
                          "styles": [
                            {
                              "property": "fontSize",
                              "value": "10"
                            },
                            {
                              "property": "color",
                              "value": "#9ca3af"
                            }
                          ]
                        }
                      },
                      {
                        "type": "component",
                        "id": "row-income-growth",
                        "component": {
                          "kind": "metric-kpi",
                          "metricDefinitionId": "Income MoM %",
                          "label": "",
                          "groupBindings": {},
                          "dimensionBindings": {},
                          "parameterBindings": {
                            "currentPeriod": {
                              "type": "dashboardDateFilter"
                            }
                          },
                          "showToneColors": true,
                          "tonePolarity": "normal",
                          "styles": [
                            {
                              "property": "fontSize",
                              "value": "14"
                            },
                            {
                              "property": "fontWeight",
                              "value": "bold"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
