                                "styles": [
                                  {
                                    "property": "fontSize",
                                    "value": "12"
                                  },
                                  {
                                    "property": "fontWeight",
                                    "value": "bold"
                                  },
                                  {
                                    "property": "color",
                                    "value": "var(--color-card-foreground)"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      },
                      {
