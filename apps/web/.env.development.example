# Copy to .env.development (gitignored) for local `pnpm --filter web dev`.
# Requires Firebase emulators: pnpm emulators + pnpm --filter api dev

VITE_ENV=dev
VITE_API_URL=http://127.0.0.1:3000

VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-project-base
VITE_FIREBASE_STORAGE_BUCKET=demo-project-base.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Opt in to Auth + App Check emulator stubs (API must set FIREBASE_AUTH_EMULATOR_HOST).
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional: test real App Check locally without Auth emulator (Firebase Console debug token).
# VITE_APP_CHECK_RECAPTCHA_SITE_KEY=
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
