API_HOST=0.0.0.0
API_PORT=3000
GCP_PROJECT_ID=demo-project-base
# Docker Compose (inside api container): use service hostnames below.
# Host-native seed (pnpm seed:database from repo root): script maps firebase-emulator → 127.0.0.1 automatically.
FIREBASE_AUTH_EMULATOR_HOST=firebase-emulator:9099
FIRESTORE_EMULATOR_HOST=firebase-emulator:8080
FIREBASE_STORAGE_EMULATOR_HOST=firebase-emulator:9199
FIREBASE_STORAGE_EMULATOR_PUBLIC_HOST=127.0.0.1:9199
GCP_STORAGE_BUCKET=demo-project-base.appspot.com
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_APP_ORIGIN=http://127.0.0.1:5173
PLATFORM_BOOTSTRAP_SUPERADMIN_EMAILS=andreslgomezo@gmail.com
TENANT_ENCRYPTION_MASTER_KEY=dy+xte03+SiE1Mqp47eC2rzmQHxBqrtm61t9hiDSAD8=

# Async aggregation (host-native e2e; Docker compose sets these automatically)
# PUBSUB_EMULATOR_HOST=127.0.0.1:8085
# AGGREGATION_EVENTS_PUBSUB=true
# AGGREGATION_EVENTS_TOPIC=aggregation-events

# AI task dispatch (Docker compose sets these automatically)
# WORKER_SERVICE_URL=http://worker-service:3001
# AI_TASKS_LOCAL_DISPATCH=true
# CLOUD_TASKS_QUEUE_NAME=ai-jobs

# Gmail ingest (optional; Docker compose sets local dispatch + queue name)
# Create a local OAuth Web client with redirect http://127.0.0.1:3000/api/gmail/oauth/callback
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/gmail/oauth/callback
# GMAIL_OAUTH_STATE_SECRET=dev-gmail-oauth-state-secret
# GMAIL_PUBSUB_TOPIC=
# (empty locally — use Sync now in Email settings; set topic + tunnel for push)
# GMAIL_TASKS_QUEUE_NAME=gmail-jobs
# GMAIL_TASKS_LOCAL_DISPATCH=true
