{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node esbuild.mjs",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:unused": "knip --no-progress",
    "lint:circular": "node ../../scripts/lint-circular.mjs --circular --extensions ts src/"
  },
  "dependencies": {
    "@fastify/compress": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@google-cloud/firestore": "catalog:",
    "@app/platform": "workspace:*",
    "@repo/dynamic-entities": "workspace:*",
    "@repo/encryption": "workspace:*",
    "@repo/entities": "workspace:*",
    "@repo/entity-relations": "workspace:*",
    "@repo/firestore-converters": "workspace:*",
    "@repo/gcp-firebase": "workspace:*",
    "@repo/hooks": "workspace:*",
    "@repo/modules": "workspace:*",
    "@repo/query-engine": "workspace:*",
    "@repo/rbac": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "fastify": "catalog:",
    "firebase-admin": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
