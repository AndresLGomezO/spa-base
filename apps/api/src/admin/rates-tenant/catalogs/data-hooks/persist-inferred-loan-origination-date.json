{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Persist inferred loan origination date",
    "description": "Infer originationDate for NONE/flat plans only (constant principalPortion). Skipped for FRENCH/GERMAN/AMERICAN/BULLET.",
    "entity": "loanDetails",
    "phase": "after",
    "trigger": {
      "operation": "create"
    },
    "condition": {
      "type": "group",
      "combinator": "and",
      "children": [
        {
          "type": "group",
          "combinator": "or",
          "children": [
            {
              "type": "condition",
              "field": "amortizationType",
              "operator": "==",
              "value": {
                "kind": "literal",
                "value": "NONE"
              }
            },
            {
              "type": "condition",
              "field": "amortizationType",
              "operator": "isEmpty"
            }
          ]
        },
        {
          "type": "condition",
          "field": "principalPortion",
          "operator": "isNotEmpty"
        },
        {
          "type": "condition",
          "field": "principalPortion",
          "operator": ">",
          "value": {
            "kind": "literal",
            "value": 0
          }
        },
        {
          "type": "condition",
          "field": "originalPrincipal",
          "operator": "isNotEmpty"
        }
      ]
    },
    "actions": [
      {
        "type": "getRecord",
        "entity": "financialItem",
        "id": {
          "kind": "field",
          "source": "current",
          "path": "financialItemId"
        },
        "as": "parent"
      },
      {
        "type": "updateMatching",
        "entity": "loanDetails",
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "id",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "id"
              }
            },
            {
              "type": "condition",
              "field": "originationDate",
              "operator": "isEmpty"
            }
          ]
        },
        "set": {
          "originationDate": {
            "kind": "formula",
            "name": "inferFlatLoanOriginationDate",
            "inputs": {}
          }
        }
      }
    ],
    "enabled": true,
    "order": -1
  }
}
