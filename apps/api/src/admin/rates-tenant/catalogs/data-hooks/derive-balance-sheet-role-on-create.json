{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Derive balance sheet role on create",
    "description": "Map itemType to balanceSheetRole via switch (debt → LIABILITY, investment → ASSET, default NONE).",
    "entity": "financialItem",
    "phase": "before",
    "trigger": {
      "operation": "create"
    },
    "condition": null,
    "actions": [
      {
        "type": "setField",
        "field": "balanceSheetRole",
        "value": {
          "kind": "formula",
          "name": "balanceSheetRoleFromItemType",
          "inputs": {
            "itemType": {
              "kind": "field",
              "source": "current",
              "path": "itemType"
            }
          }
        }
      }
    ],
    "enabled": true,
    "order": 1
  }
}
