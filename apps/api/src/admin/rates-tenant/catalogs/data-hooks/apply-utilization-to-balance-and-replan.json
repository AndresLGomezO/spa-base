{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Apply utilization to balance and replan",
    "description": "Increase financialItem.currentBalance on draw and bump loanDetails.planRevision to trigger loan payment plan replan.",
    "entity": "loanUtilization",
    "phase": "after",
    "trigger": {
      "operation": "create"
    },
    "condition": null,
    "actions": [
      {
        "type": "updateMatching",
        "entity": "financialItem",
        "where": {
          "type": "condition",
          "field": "id",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "financialItemId"
          }
        },
        "set": {
          "currentBalance": {
            "kind": "binary",
            "op": "+",
            "left": {
              "kind": "call",
              "fn": "coalesce",
              "args": [
                {
                  "kind": "field",
                  "source": "current",
                  "path": "currentBalance"
                },
                {
                  "kind": "literal",
                  "value": 0
                }
              ]
            },
            "right": {
              "kind": "field",
              "source": "previous",
              "path": "amount"
            }
          }
        }
      },
      {
        "type": "updateMatching",
        "entity": "loanDetails",
        "where": {
          "type": "condition",
          "field": "financialItemId",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "financialItemId"
          }
        },
        "set": {
          "planRevision": {
            "kind": "formula",
            "name": "incrementPlanRevision",
            "inputs": {}
          }
        }
      }
    ],
    "enabled": true,
    "order": 0,
    "chainHooks": true,
    "execution": "queued"
  }
}
