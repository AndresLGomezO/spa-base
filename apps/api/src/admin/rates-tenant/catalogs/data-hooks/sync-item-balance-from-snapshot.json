{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Sync item balance from snapshot",
    "description": "Copy balanceSnapshot.balance to financialItem.currentBalance.",
    "entity": "balanceSnapshot",
    "phase": "after",
    "trigger": {
      "operation": "create"
    },
    "condition": null,
    "actions": [
      {
        "type": "updateMatching",
        "entity": "financialItem",
        "where": {
          "field": "id",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "financialItemId"
          }
        },
        "set": {
          "currentBalance": {
            "kind": "field",
            "source": "previous",
            "path": "balance"
          }
        }
      }
    ],
    "enabled": true,
    "order": 0,
    "execution": "queued"
  }
}
