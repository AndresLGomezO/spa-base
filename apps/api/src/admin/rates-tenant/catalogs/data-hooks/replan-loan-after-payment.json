{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Replan loan after payment",
    "description": "Bump loanDetails.planRevision after payment so amortizing loans replan from live balance + advanced nextDueDate. Skips CREDIT_CARD / NONE terms (no loanDetails row with FRENCH/GERMAN/AMERICAN/BULLET) — cards keep Mark PAID + Roll forward instead of wiping UPCOMING. Order after Advance next due date.",
    "entity": "transaction",
    "phase": "after",
    "trigger": {
      "operation": "create"
    },
    "condition": {
      "type": "group",
      "combinator": "and",
      "children": [
        {
          "type": "condition",
          "field": "type",
          "operator": "==",
          "value": {
            "kind": "literal",
            "value": "PAYMENT"
          }
        },
        {
          "type": "condition",
          "field": "financialItemId",
          "operator": "isNotEmpty"
        }
      ]
    },
    "actions": [
      {
        "type": "updateMatching",
        "entity": "loanDetails",
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "financialItemId"
              }
            },
            {
              "type": "condition",
              "field": "amortizationType",
              "operator": "in",
              "value": {
                "kind": "literal",
                "value": [
                  "FRENCH",
                  "GERMAN",
                  "AMERICAN",
                  "BULLET"
                ]
              }
            }
          ]
        },
        "set": {
          "planRevision": {
            "kind": "formula",
            "name": "incrementPlanRevision",
            "inputs": {}
          }
        }
      }
    ],
    "enabled": true,
    "order": 5,
    "chainHooks": true
  }
}
