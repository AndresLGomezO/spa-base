{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Email Reversal",
    "description": "Find a matching transaction (same financial item + amount, not already reversed) and mark it reversed; if none exists, create one with reversed=true. Date is not required for matching because reversal emails often use a different Fecha than the original purchase.",
    "entity": "financialItem",
    "phase": "after",
    "trigger": {
      "kind": "email"
    },
    "condition": {
      "type": "group",
      "combinator": "and",
      "children": [
        {
          "type": "condition",
          "field": "__emailRelevant",
          "operator": "==",
          "value": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "type": "condition",
          "field": "__extracted.fields.isReversal",
          "operator": "==",
          "value": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "type": "condition",
          "field": "__extracted.fields.amount",
          "operator": "isNotEmpty"
        },
        {
          "type": "condition",
          "field": "__extracted.fields.emailKind",
          "operator": "!=",
          "value": {
            "kind": "literal",
            "value": "creditCardStatement"
          }
        }
      ]
    },
    "actions": [
      {
        "type": "getOrCreateRecord",
        "entity": "transaction",
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "id"
              }
            },
            {
              "type": "condition",
              "field": "amount",
              "operator": "==",
              "value": {
                "kind": "call",
                "fn": "toNumber",
                "args": [
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__extracted.fields.amount"
                  }
                ]
              }
            },
            {
              "type": "condition",
              "field": "reversed",
              "operator": "!=",
              "value": {
                "kind": "literal",
                "value": true
              }
            }
          ]
        },
        "data": {
          "financialItemId": {
            "kind": "field",
            "source": "current",
            "path": "id"
          },
          "accountId": {
            "kind": "field",
            "source": "current",
            "path": "accountId"
          },
          "categoryId": {
            "kind": "field",
            "source": "current",
            "path": "categoryId"
          },
          "amount": {
            "kind": "call",
            "fn": "toNumber",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.amount"
              }
            ]
          },
          "type": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.type"
              },
              {
                "kind": "literal",
                "value": "EXPENSE"
              }
            ]
          },
          "date": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.date"
              },
              {
                "kind": "field",
                "source": "current",
                "path": "__email.date"
              },
              {
                "kind": "var",
                "name": "now"
              }
            ]
          },
          "description": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.description"
              },
              {
                "kind": "field",
                "source": "current",
                "path": "__email.subject"
              },
              {
                "kind": "field",
                "source": "current",
                "path": "__email.snippet"
              },
              {
                "kind": "literal",
                "value": "Email reversal transaction"
              }
            ]
          },
          "reversed": {
            "kind": "literal",
            "value": true
          },
          "emailId": {
            "kind": "field",
            "source": "current",
            "path": "__emailLedger.id"
          }
        },
        "as": "reversedTxn"
      },
      {
        "type": "updateMatching",
        "entity": "transaction",
        "where": {
          "type": "condition",
          "field": "id",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "loaded",
            "alias": "reversedTxn",
            "path": "id"
          }
        },
        "set": {
          "reversed": {
            "kind": "literal",
            "value": true
          },
          "emailId": {
            "kind": "field",
            "source": "current",
            "path": "__emailLedger.id"
          }
        }
      },
      {
        "type": "sendNotification",
        "message": {
          "kind": "call",
          "fn": "concat",
          "args": [
            {
              "kind": "literal",
              "value": "Email reversal: reversed transaction "
            },
            {
              "kind": "field",
              "source": "current",
              "path": "__extracted.fields.amount"
            },
            {
              "kind": "literal",
              "value": " on "
            },
            {
              "kind": "call",
              "fn": "coalesce",
              "args": [
                {
                  "kind": "field",
                  "source": "current",
                  "path": "__extracted.fields.date"
                },
                {
                  "kind": "literal",
                  "value": "(unknown date)"
                }
              ]
            },
            {
              "kind": "literal",
              "value": " — "
            },
            {
              "kind": "call",
              "fn": "coalesce",
              "args": [
                {
                  "kind": "field",
                  "source": "current",
                  "path": "__extracted.fields.description"
                },
                {
                  "kind": "field",
                  "source": "current",
                  "path": "__email.subject"
                },
                {
                  "kind": "literal",
                  "value": "(no description)"
                }
              ]
            }
          ]
        },
        "recordEntity": {
          "kind": "literal",
          "value": "financialItem"
        },
        "recordId": {
          "kind": "field",
          "source": "current",
          "path": "id"
        }
      }
    ],
    "enabled": true,
    "order": 1,
    "chainHooks": false
  }
}
