{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Mark schedule PAID",
    "description": "When a transaction links paymentScheduleId, mark that schedule PAID.",
    "entity": "transaction",
    "phase": "after",
    "trigger": {
      "operation": "create"
    },
    "chainHooks": true,
    "condition": {
      "type": "condition",
      "field": "paymentScheduleId",
      "operator": "isNotEmpty"
    },
    "actions": [
      {
        "type": "updateMatching",
        "entity": "paymentSchedule",
        "where": {
          "field": "id",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "paymentScheduleId"
          }
        },
        "set": {
          "status": {
            "kind": "literal",
            "value": "PAID"
          },
          "paidTransactionId": {
            "kind": "field",
            "source": "previous",
            "path": "id"
          }
        }
      }
    ],
    "enabled": true,
    "order": 0
  }
}
