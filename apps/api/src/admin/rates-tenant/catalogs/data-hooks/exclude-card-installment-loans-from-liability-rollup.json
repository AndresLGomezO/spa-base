{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Exclude card installment loans from liability rollup",
    "description": "Linked child LOAN items roll up to host card — balanceSheetRole NONE.",
    "entity": "financialItem",
    "phase": "before",
    "trigger": {
      "operation": "create"
    },
    "condition": {
      "type": "condition",
      "field": "parentFinancialItemId",
      "operator": "isNotEmpty"
    },
    "actions": [
      {
        "type": "setField",
        "field": "balanceSheetRole",
        "value": {
          "kind": "literal",
          "value": "NONE"
        }
      }
    ],
    "enabled": true,
    "order": 2
  }
}
