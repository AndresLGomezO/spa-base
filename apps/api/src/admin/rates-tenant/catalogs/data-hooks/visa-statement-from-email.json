{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Visa statement from email",
    "description": "Davivienda monthly extracto email: upsert the period statement, link the imported STATEMENT PDF, and when min payment / due date are extracted patch the matching open payment schedule (and card nextDueDate only if that schedule is the earliest open bill).",
    "entity": "financialItem",
    "phase": "after",
    "trigger": {
      "kind": "email",
      "bindingIds": [
        "emb_0819cd3c_0"
      ]
    },
    "condition": {
      "type": "condition",
      "field": "__emailRelevant",
      "operator": "==",
      "value": {
        "kind": "literal",
        "value": true
      }
    },
    "actions": [
      {
        "type": "getOrCreateRecord",
        "entity": "statement",
        "where": {
          "type": "condition",
          "field": "sourceGmailMessageId",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "__email.messageId"
          }
        },
        "data": {
          "name": {
            "kind": "call",
            "fn": "concat",
            "args": [
              {
                "kind": "literal",
                "value": "Statement "
              },
              {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__extracted.fields.statementDate"
                  },
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__email.date"
                  },
                  {
                    "kind": "literal",
                    "value": ""
                  }
                ]
              }
            ]
          },
          "financialItemId": {
            "kind": "field",
            "source": "current",
            "path": "id"
          },
          "accountId": {
            "kind": "field",
            "source": "current",
            "path": "accountId"
          },
          "periodEnd": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.statementDate"
              },
              {
                "kind": "field",
                "source": "current",
                "path": "__email.date"
              }
            ]
          },
          "statementDate": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.statementDate"
              },
              {
                "kind": "field",
                "source": "current",
                "path": "__email.date"
              }
            ]
          },
          "minPayment": {
            "kind": "field",
            "source": "current",
            "path": "__extracted.fields.amount"
          },
          "paymentDueDate": {
            "kind": "field",
            "source": "current",
            "path": "__extracted.fields.nextDueDate"
          },
          "closingBalance": {
            "kind": "field",
            "source": "current",
            "path": "__extracted.fields.closingBalance"
          },
          "currency": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "currency"
              },
              {
                "kind": "literal",
                "value": "COP"
              }
            ]
          },
          "status": {
            "kind": "literal",
            "value": "applied"
          },
          "emailId": {
            "kind": "field",
            "source": "current",
            "path": "__emailLedger.id"
          },
          "sourceGmailMessageId": {
            "kind": "field",
            "source": "current",
            "path": "__email.messageId"
          }
        },
        "as": "periodStatement"
      },
      {
        "type": "getOrCreateRecord",
        "entity": "paymentSchedule",
        "createIfMissing": false,
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "id"
              }
            },
            {
              "type": "condition",
              "field": "dueDate",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.nextDueDate"
              }
            }
          ]
        },
        "as": "statementByDue"
      },
      {
        "type": "aggregateMatching",
        "entity": "paymentSchedule",
        "op": "min",
        "field": "dueDate",
        "as": "openDueOnOrAfterStatement",
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "id"
              }
            },
            {
              "type": "condition",
              "field": "dueDate",
              "operator": ">=",
              "value": {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__extracted.fields.statementDate"
                  },
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__email.date"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "getOrCreateRecord",
        "entity": "paymentSchedule",
        "createIfMissing": false,
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "id"
              }
            },
            {
              "type": "condition",
              "field": "dueDate",
              "operator": "==",
              "value": {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "field",
                    "source": "loaded",
                    "alias": "statementByDue",
                    "path": "dueDate"
                  },
                  {
                    "kind": "field",
                    "source": "aggregate",
                    "alias": "openDueOnOrAfterStatement"
                  }
                ]
              }
            }
          ]
        },
        "as": "statementSchedule"
      },
      {
        "type": "aggregateMatching",
        "entity": "paymentSchedule",
        "op": "min",
        "field": "dueDate",
        "as": "earliestOpenDue",
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "id"
              }
            },
            {
              "type": "condition",
              "field": "status",
              "operator": "in",
              "value": {
                "kind": "literal",
                "value": [
                  "UPCOMING",
                  "OVERDUE"
                ]
              }
            }
          ]
        }
      },
      {
        "type": "updateMatching",
        "entity": "paymentSchedule",
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "id",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "loaded",
                "alias": "statementSchedule",
                "path": "id"
              }
            }
          ]
        },
        "set": {
          "expectedAmount": {
            "kind": "field",
            "source": "current",
            "path": "__extracted.fields.amount"
          },
          "dueDate": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.nextDueDate"
              },
              {
                "kind": "field",
                "source": "loaded",
                "alias": "statementSchedule",
                "path": "dueDate"
              }
            ]
          },
          "emailId": {
            "kind": "field",
            "source": "current",
            "path": "__emailLedger.id"
          },
          "statementId": {
            "kind": "field",
            "source": "loaded",
            "alias": "periodStatement",
            "path": "id"
          }
        }
      },
      {
        "type": "updateMatching",
        "entity": "financialItem",
        "where": {
          "type": "condition",
          "field": "id",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "id"
          }
        },
        "set": {
          "nextDueDate": {
            "kind": "call",
            "fn": "if",
            "args": [
              {
                "kind": "binary",
                "op": "&&",
                "left": {
                  "kind": "unary",
                  "op": "!",
                  "operand": {
                    "kind": "call",
                    "fn": "isEmpty",
                    "args": [
                      {
                        "kind": "field",
                        "source": "loaded",
                        "alias": "statementSchedule",
                        "path": "id"
                      }
                    ]
                  }
                },
                "right": {
                  "kind": "binary",
                  "op": "==",
                  "left": {
                    "kind": "call",
                    "fn": "dateOnly",
                    "args": [
                      {
                        "kind": "field",
                        "source": "loaded",
                        "alias": "statementSchedule",
                        "path": "dueDate"
                      }
                    ]
                  },
                  "right": {
                    "kind": "call",
                    "fn": "dateOnly",
                    "args": [
                      {
                        "kind": "field",
                        "source": "aggregate",
                        "alias": "earliestOpenDue"
                      }
                    ]
                  }
                }
              },
              {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__extracted.fields.nextDueDate"
                  },
                  {
                    "kind": "field",
                    "source": "loaded",
                    "alias": "statementSchedule",
                    "path": "dueDate"
                  }
                ]
              },
              {
                "kind": "field",
                "source": "current",
                "path": "nextDueDate"
              }
            ]
          },
          "emailId": {
            "kind": "field",
            "source": "current",
            "path": "__emailLedger.id"
          },
          "statementId": {
            "kind": "field",
            "source": "loaded",
            "alias": "periodStatement",
            "path": "id"
          }
        }
      },
      {
        "type": "updateMatching",
        "entity": "attachment",
        "where": {
          "type": "condition",
          "field": "description",
          "operator": "==",
          "value": {
            "kind": "call",
            "fn": "concat",
            "args": [
              {
                "kind": "literal",
                "value": "gmail:"
              },
              {
                "kind": "field",
                "source": "current",
                "path": "__email.messageId"
              }
            ]
          }
        },
        "set": {
          "statementId": {
            "kind": "field",
            "source": "loaded",
            "alias": "periodStatement",
            "path": "id"
          }
        }
      },
      {
        "type": "sendNotification",
        "message": {
          "kind": "call",
          "fn": "concat",
          "args": [
            {
              "kind": "literal",
              "value": "Statement applied for "
            },
            {
              "kind": "field",
              "source": "current",
              "path": "name"
            },
            {
              "kind": "literal",
              "value": ": min payment "
            },
            {
              "kind": "field",
              "source": "current",
              "path": "__extracted.fields.amount"
            },
            {
              "kind": "literal",
              "value": ", due "
            },
            {
              "kind": "call",
              "fn": "coalesce",
              "args": [
                {
                  "kind": "field",
                  "source": "current",
                  "path": "__extracted.fields.nextDueDate"
                },
                {
                  "kind": "literal",
                  "value": "(unknown)"
                }
              ]
            }
          ]
        },
        "recordEntity": {
          "kind": "literal",
          "value": "financialItem"
        },
        "recordId": {
          "kind": "field",
          "source": "current",
          "path": "id"
        }
      }
    ],
    "enabled": true,
    "order": -1,
    "chainHooks": false
  }
}
