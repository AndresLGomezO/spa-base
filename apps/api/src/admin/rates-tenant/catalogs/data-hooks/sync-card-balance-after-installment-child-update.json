{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Sync card balance after installment child update",
    "description": "Recompute host card currentBalance when a linked child LOAN balance changes.",
    "entity": "financialItem",
    "phase": "after",
    "trigger": {
      "operation": "update",
      "updateFields": [
        "currentBalance",
        "parentFinancialItemId",
        "status"
      ]
    },
    "condition": {
      "type": "condition",
      "field": "parentFinancialItemId",
      "operator": "isNotEmpty"
    },
    "actions": [
      {
        "type": "aggregateMatching",
        "entity": "financialItem",
        "op": "sum",
        "field": "currentBalance",
        "as": "installmentSum",
        "where": {
          "type": "condition",
          "field": "parentFinancialItemId",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "parentFinancialItemId"
          }
        }
      },
      {
        "type": "updateMatching",
        "entity": "financialItem",
        "where": {
          "field": "id",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "parentFinancialItemId"
          }
        },
        "set": {
          "currentBalance": {
            "kind": "formula",
            "name": "cardHostCurrentBalance",
            "inputs": {
              "revolvingBalance": {
                "kind": "field",
                "source": "current",
                "path": "revolvingBalance"
              },
              "installmentSum": {
                "kind": "field",
                "source": "aggregate",
                "alias": "installmentSum"
              }
            }
          }
        }
      }
    ],
    "enabled": true,
    "order": 0,
    "execution": "queued"
  }
}
