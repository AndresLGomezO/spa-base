{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Cascade delete related records",
    "description": "Remove paymentSchedule, loanDetails, balanceSnapshot, and statement rows when a financialItem is deleted.",
    "entity": "financialItem",
    "phase": "after",
    "trigger": {
      "operation": "delete"
    },
    "condition": null,
    "actions": [
      {
        "type": "deleteMatching",
        "entity": "paymentSchedule",
        "where": {
          "field": "financialItemId",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "id"
          }
        }
      },
      {
        "type": "deleteMatching",
        "entity": "loanDetails",
        "where": {
          "field": "financialItemId",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "id"
          }
        }
      },
      {
        "type": "deleteMatching",
        "entity": "balanceSnapshot",
        "where": {
          "field": "financialItemId",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "id"
          }
        }
      },
      {
        "type": "deleteMatching",
        "entity": "statement",
        "where": {
          "field": "financialItemId",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "id"
          }
        }
      }
    ],
    "enabled": true,
    "order": 20,
    "chainHooks": true,
    "execution": "queued"
  }
}
