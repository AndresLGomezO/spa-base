            "kind": "field",
            "source": "loaded",
            "alias": "linkedTransaction",
            "path": "id"
          }
        },
        "set": {
          "relatedFinancialItemId": {
            "kind": "call",
            "fn": "if",
            "args": [
              {
                "kind": "binary",
                "op": "==",
                "left": {
                  "kind": "field",
                  "source": "loaded",
                  "alias": "linkedTransaction",
                  "path": "financialItemId"
                },
                "right": {
                  "kind": "field",
                  "source": "previous",
                  "path": "id"
                }
              },
              {
                "kind": "field",
                "source": "loaded",
                "alias": "linkedTransaction",
                "path": "relatedFinancialItemId"
              },
              {
                "kind": "field",
                "source": "previous",
                "path": "id"
              }
            ]
          },
          "paymentScheduleId": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "loaded",
                "alias": "linkSchedule",
                "path": "id"
              },
              {
                "kind": "field",
                "source": "loaded",
                "alias": "linkedTransaction",
                "path": "paymentScheduleId"
              }
            ]
          },
