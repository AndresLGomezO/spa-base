              }
            },
            {
              "type": "condition",
              "field": "description",
              "operator": "contains",
              "value": {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__extracted.fields.descriptionMatch"
