                  "type": "group",
                  "combinator": "and",
                  "children": [
                    {
                      "type": "condition",
                      "field": "relatedFinancialItemId",
                      "operator": "==",
                      "value": {
                        "kind": "field",
                        "source": "current",
                        "path": "id"
