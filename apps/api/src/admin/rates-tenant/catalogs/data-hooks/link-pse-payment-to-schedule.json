{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Link payment to schedule",
    "description": "Link emails for Planilla, Hipoteca Granada, Hipoteca Altavista, Cuota inicial Av Colón, Administración Granada, Crediservice Rotativo, Scaleno 17, Mastercard Black, Visa Signature, Visa Davivienda card payment, Móvil Mamá, Internet Centenari (+ Móvil Leo), Arriendo Granada, Arriendo Altavista, and card subscriptions (Apple iCloud, Netflix): find the hub/card transaction (same Gmail message id + amount, or parent/hub FI + amount + date + optional descriptionMatch) and attach this financial item plus the closest open payment schedule. Does not create transactions — no-op if the source payment is missing.",
    "entity": "financialItem",
    "phase": "after",
    "trigger": {
      "kind": "email",
      "bindingIds": [
        "emb_06e5cb41_0",
        "emb_cf757971_10",
        "emb_cf757971_11",
        "emb_15379d6f_10",
        "emb_2f136855_10",
        "emb_7207ba42_10",
        "emb_cc79f3bd_10",
        "emb_dfc52452_10",
        "emb_f613909f_10",
        "emb_e6c42ac0_10",
        "emb_9f660323_10",
        "emb_b3068c84_10",
        "emb_0819cd3c_10",
        "emb_606ac06d_10",
        "emb_07d18b8f_10",
        "emb_18846ba8_10",
        "emb_a737d3ed_10",
        "emb_c3d7ba89_10"
      ]
    },
    "condition": {
      "type": "group",
      "combinator": "and",
      "children": [
        {
          "type": "condition",
          "field": "__emailRelevant",
          "operator": "==",
          "value": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "type": "condition",
          "field": "__extracted.fields.amount",
          "operator": "isNotEmpty"
        }
      ]
    },
    "actions": [
      {
        "type": "aggregateMatching",
        "entity": "paymentSchedule",
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "id"
              }
            },
            {
              "type": "condition",
              "field": "status",
              "operator": "in",
              "value": {
                "kind": "literal",
                "value": [
                  "UPCOMING",
                  "OVERDUE",
                  "PAID"
                ]
              }
            },
            {
              "type": "condition",
              "field": "dueDate",
              "operator": "<=",
              "value": {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__extracted.fields.date"
                  },
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__email.date"
                  },
                  {
                    "kind": "var",
                    "name": "now"
                  }
                ]
              }
            }
          ]
        },
        "op": "max",
        "field": "dueDate",
        "as": "linkDueOnOrBefore"
      },
      {
        "type": "aggregateMatching",
        "entity": "paymentSchedule",
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "id"
              }
            },
            {
              "type": "condition",
              "field": "status",
              "operator": "in",
              "value": {
                "kind": "literal",
                "value": [
                  "UPCOMING",
                  "OVERDUE"
                ]
              }
            },
            {
              "type": "condition",
              "field": "dueDate",
              "operator": ">=",
              "value": {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__extracted.fields.date"
                  },
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__email.date"
                  },
                  {
                    "kind": "var",
                    "name": "now"
                  }
                ]
              }
            }
          ]
        },
        "op": "min",
        "field": "dueDate",
        "as": "linkDueOnOrAfter"
      },
      {
        "type": "getOrCreateRecord",
        "entity": "paymentSchedule",
        "createIfMissing": false,
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "id"
              }
            },
            {
              "type": "condition",
              "field": "dueDate",
              "operator": "==",
              "value": {
                "kind": "call",
                "fn": "if",
                "args": [
                  {
                    "kind": "call",
                    "fn": "isEmpty",
                    "args": [
                      {
                        "kind": "field",
                        "source": "aggregate",
                        "alias": "linkDueOnOrBefore"
                      }
                    ]
                  },
                  {
                    "kind": "field",
                    "source": "aggregate",
                    "alias": "linkDueOnOrAfter"
                  },
                  {
                    "kind": "call",
                    "fn": "if",
                    "args": [
                      {
                        "kind": "call",
                        "fn": "isEmpty",
                        "args": [
                          {
                            "kind": "field",
                            "source": "aggregate",
                            "alias": "linkDueOnOrAfter"
                          }
                        ]
                      },
                      {
                        "kind": "field",
                        "source": "aggregate",
                        "alias": "linkDueOnOrBefore"
                      },
                      {
                        "kind": "call",
                        "fn": "if",
                        "args": [
                          {
                            "kind": "binary",
                            "op": "==",
                            "left": {
                              "kind": "call",
                              "fn": "coalesce",
                              "args": [
                                {
                                  "kind": "field",
                                  "source": "current",
                                  "path": "__extracted.fields.type"
