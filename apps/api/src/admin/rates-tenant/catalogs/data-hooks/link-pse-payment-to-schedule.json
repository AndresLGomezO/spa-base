                                            {
                                              "kind": "field",
                                              "source": "current",
                                              "path": "__email.date"
                                            },
                                            {
                                              "kind": "var",
                                              "name": "now"
                                            }
                                          ]
                                        },
                                        {
                                          "kind": "field",
                                          "source": "aggregate",
                                          "alias": "linkDueOnOrBefore"
                                        },
                                        {
                                          "kind": "literal",
                                          "value": "DAY"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                "right": {
                                  "kind": "call",
                                  "fn": "abs",
                                  "args": [
                                    {
                                      "kind": "call",
                                      "fn": "dateDiff",
                                      "args": [
                                        {
                                          "kind": "call",
                                          "fn": "coalesce",
                                          "args": [
                                            {
                                              "kind": "field",
                                              "source": "current",
                                              "path": "__extracted.fields.date"
                                            },
                                            {
                                              "kind": "field",
                                              "source": "current",
                                              "path": "__email.date"
                                            },
                                            {
                                              "kind": "var",
                                              "name": "now"
                                            }
                                          ]
                                        },
                                        {
                                          "kind": "field",
                                          "source": "aggregate",
                                          "alias": "linkDueOnOrAfter"
                                        },
                                        {
                                          "kind": "literal",
                                          "value": "DAY"
                                        }
                                      ]
                                    }
                                  ]
                                }
                              },
                              {
                                "kind": "field",
                                "source": "aggregate",
                                "alias": "linkDueOnOrBefore"
                              },
                              {
                                "kind": "field",
                                "source": "aggregate",
                                "alias": "linkDueOnOrAfter"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "condition",
              "field": "status",
              "operator": "in",
              "value": {
                "kind": "literal",
                "value": [
                  "UPCOMING",
                  "OVERDUE",
                  "PAID"
                ]
              }
            }
          ]
