                                {
                                  "kind": "literal",
                                  "value": "EXPENSE"
                                }
                              ]
                            },
                            "right": {
                              "kind": "literal",
                              "value": "INCOME"
                            }
                          },
                          {
                            "kind": "field",
                            "source": "aggregate",
                            "alias": "linkDueOnOrAfter"
                          },
                          {
                            "kind": "call",
                            "fn": "if",
                            "args": [
                              {
                                "kind": "binary",
                                "op": "<=",
                                "left": {
                                  "kind": "call",
                                  "fn": "abs",
                                  "args": [
                                    {
                                      "kind": "call",
                                      "fn": "dateDiff",
                                      "args": [
                                        {
                                          "kind": "call",
                                          "fn": "coalesce",
                                          "args": [
                                            {
                                              "kind": "field",
                                              "source": "current",
                                              "path": "__extracted.fields.date"
