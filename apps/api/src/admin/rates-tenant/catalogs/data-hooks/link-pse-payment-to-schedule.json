                ]
              }
            },
            {
              "type": "group",
              "combinator": "or",
              "children": [
                {
                  "type": "condition",
                  "field": "sourceGmailMessageId",
                  "operator": "==",
                  "value": {
                    "kind": "field",
                    "source": "current",
                    "path": "__email.messageId"
                  }
                },
                {
                  "type": "condition",
                  "field": "relatedFinancialItemId",
                  "operator": "==",
                  "value": {
                    "kind": "field",
                    "source": "current",
                    "path": "id"
                  }
                },
                {
                  "type": "group",
                  "combinator": "and",
                  "children": [
                    {
                      "type": "condition",
                      "field": "financialItemId",
                      "operator": "==",
                      "value": {
                        "kind": "call",
                        "fn": "coalesce",
                        "args": [
                          {
                            "kind": "field",
                            "source": "current",
                            "path": "parentFinancialItemId"
                          },
                          {
                            "kind": "field",
                            "source": "current",
                            "path": "__extracted.fields.hubFinancialItemId"
                          },
                          {
                            "kind": "literal",
                            "value": "__never_match_parent__"
