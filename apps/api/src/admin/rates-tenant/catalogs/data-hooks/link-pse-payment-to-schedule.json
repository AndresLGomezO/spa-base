                      }
                    },
                    {
                      "type": "condition",
                      "field": "date",
                      "operator": ">=",
                      "value": {
                        "kind": "call",
                        "fn": "dateOnly",
                        "args": [
                          {
                            "kind": "call",
                            "fn": "coalesce",
                            "args": [
                              {
                                "kind": "field",
                                "source": "current",
                                "path": "__extracted.fields.date"
                              },
                              {
                                "kind": "field",
                                "source": "current",
                                "path": "__email.date"
                              },
                              {
                                "kind": "var",
                                "name": "now"
                              }
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "type": "condition",
                      "field": "date",
                      "operator": "<",
                      "value": {
                        "kind": "call",
                        "fn": "dateAdd",
                        "args": [
                          {
                            "kind": "call",
                            "fn": "dateOnly",
                            "args": [
                              {
                                "kind": "call",
                                "fn": "coalesce",
                                "args": [
                                  {
                                    "kind": "field",
                                    "source": "current",
                                    "path": "__extracted.fields.date"
                                  },
                                  {
                                    "kind": "field",
                                    "source": "current",
                                    "path": "__email.date"
                                  },
                                  {
                                    "kind": "var",
                                    "name": "now"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "kind": "literal",
                            "value": 1
                          },
                          {
                            "kind": "literal",
                            "value": "DAY"
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
