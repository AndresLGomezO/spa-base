{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Complete one-time item on payment",
    "description": "When paying a ONE_TIME item, mark financialItem COMPLETED.",
    "entity": "transaction",
    "phase": "after",
    "trigger": {
      "operation": "create"
    },
    "condition": {
      "type": "group",
      "combinator": "and",
      "children": [
        {
          "type": "condition",
          "field": "type",
          "operator": "==",
          "value": {
            "kind": "literal",
            "value": "PAYMENT"
          }
        },
        {
          "type": "condition",
          "field": "financialItemId",
          "operator": "isNotEmpty"
        }
      ]
    },
    "actions": [
      {
        "type": "getRecord",
        "entity": "financialItem",
        "id": {
          "kind": "field",
          "source": "current",
          "path": "financialItemId"
        },
        "as": "parent"
      },
      {
        "type": "updateMatching",
        "entity": "financialItem",
        "where": {
          "field": "id",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "financialItemId"
          }
        },
        "set": {
          "status": {
            "kind": "call",
            "fn": "if",
            "args": [
              {
                "kind": "binary",
                "op": "==",
                "left": {
                  "kind": "field",
                  "source": "loaded",
                  "alias": "parent",
                  "path": "frequency"
                },
                "right": {
                  "kind": "literal",
                  "value": "ONE_TIME"
                }
              },
              {
                "kind": "literal",
                "value": "COMPLETED"
              },
              {
                "kind": "field",
                "source": "current",
                "path": "status"
              }
            ]
          }
        }
      }
    ],
    "enabled": true,
    "order": 7
  }
}
