{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Advance next due date on link",
    "description": "After a payment is linked to a related financial item / schedule, set that item's nextDueDate to the earliest remaining UPCOMING or OVERDUE schedule dueDate.",
    "entity": "transaction",
    "phase": "after",
    "trigger": {
      "operation": "update",
      "updateFields": [
        "paymentScheduleId",
        "relatedFinancialItemId"
      ]
    },
    "condition": {
      "type": "group",
      "combinator": "and",
      "children": [
        {
          "type": "condition",
          "field": "paymentScheduleId",
          "operator": "isNotEmpty"
        },
        {
          "type": "condition",
          "field": "relatedFinancialItemId",
          "operator": "isNotEmpty"
        }
      ]
    },
    "actions": [
      {
        "type": "aggregateMatching",
        "entity": "paymentSchedule",
        "op": "min",
        "field": "dueDate",
        "as": "nextDue",
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "relatedFinancialItemId"
              }
            },
            {
              "type": "condition",
              "field": "status",
              "operator": "in",
              "value": {
                "kind": "literal",
                "value": [
                  "UPCOMING",
                  "OVERDUE"
                ]
              }
            }
          ]
        }
      },
      {
        "type": "updateMatching",
        "entity": "financialItem",
        "where": {
          "field": "id",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "relatedFinancialItemId"
          }
        },
        "set": {
          "nextDueDate": {
            "kind": "field",
            "source": "aggregate",
            "alias": "nextDue"
          }
        }
      }
    ],
    "enabled": true,
    "order": 2
  }
}
