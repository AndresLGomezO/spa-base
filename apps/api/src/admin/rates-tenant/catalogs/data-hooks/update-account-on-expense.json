{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Update account on expense",
    "description": "Decrease account.currentBalance for EXPENSE transactions.",
    "entity": "transaction",
    "phase": "after",
    "trigger": {
      "operation": "create"
    },
    "condition": {
      "type": "condition",
      "field": "type",
      "operator": "==",
      "value": {
        "kind": "literal",
        "value": "EXPENSE"
      }
    },
    "actions": [
      {
        "type": "updateMatching",
        "entity": "account",
        "where": {
          "field": "id",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "accountId"
          }
        },
        "set": {
          "currentBalance": {
            "kind": "binary",
            "op": "-",
            "left": {
              "kind": "call",
              "fn": "coalesce",
              "args": [
                {
                  "kind": "field",
                  "source": "current",
                  "path": "currentBalance"
                },
                {
                  "kind": "literal",
                  "value": 0
                }
              ]
            },
            "right": {
              "kind": "field",
              "source": "previous",
              "path": "amount"
            }
          }
        }
      }
    ],
    "enabled": true,
    "order": 3
  }
}
