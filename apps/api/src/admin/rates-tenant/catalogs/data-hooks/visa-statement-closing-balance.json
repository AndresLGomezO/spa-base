{
  "kind": "data-hook-definition",
  "version": 1,
  "data": {
    "name": "Visa statement closing balance",
    "description": "Davivienda monthly extracto email: when closingBalance is extracted, upsert a balanceSnapshot for periodEnd and sync the card currentBalance.",
    "entity": "financialItem",
    "phase": "after",
    "trigger": {
      "kind": "email",
      "bindingIds": [
        "emb_0819cd3c_0"
      ]
    },
    "condition": {
      "type": "group",
      "combinator": "and",
      "children": [
        {
          "type": "condition",
          "field": "__emailRelevant",
          "operator": "==",
          "value": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "type": "condition",
          "field": "__extracted.fields.closingBalance",
          "operator": "isNotEmpty"
        }
      ]
    },
    "actions": [
      {
        "type": "getOrCreateRecord",
        "entity": "statement",
        "where": {
          "type": "condition",
          "field": "sourceGmailMessageId",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "__email.messageId"
          }
        },
        "data": {
          "name": {
            "kind": "call",
            "fn": "concat",
            "args": [
              {
                "kind": "literal",
                "value": "Statement "
              },
              {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__extracted.fields.statementDate"
                  },
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__email.date"
                  },
                  {
                    "kind": "literal",
                    "value": ""
                  }
                ]
              }
            ]
          },
          "financialItemId": {
            "kind": "field",
            "source": "current",
            "path": "id"
          },
          "periodEnd": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.statementDate"
              },
              {
                "kind": "field",
                "source": "current",
                "path": "__email.date"
              }
            ]
          },
          "statementDate": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.statementDate"
              },
              {
                "kind": "field",
                "source": "current",
                "path": "__email.date"
              }
            ]
          },
          "closingBalance": {
            "kind": "field",
            "source": "current",
            "path": "__extracted.fields.closingBalance"
          },
          "minPayment": {
            "kind": "field",
            "source": "current",
            "path": "__extracted.fields.amount"
          },
          "paymentDueDate": {
            "kind": "field",
            "source": "current",
            "path": "__extracted.fields.nextDueDate"
          },
          "currency": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "current",
                "path": "currency"
              },
              {
                "kind": "literal",
                "value": "COP"
              }
            ]
          },
          "status": {
            "kind": "literal",
            "value": "applied"
          },
          "emailId": {
            "kind": "field",
            "source": "current",
            "path": "__emailLedger.id"
          },
          "sourceGmailMessageId": {
            "kind": "field",
            "source": "current",
            "path": "__email.messageId"
          }
        },
        "as": "periodStatement"
      },
      {
        "type": "getOrCreateRecord",
        "entity": "balanceSnapshot",
        "where": {
          "type": "group",
          "combinator": "and",
          "children": [
            {
              "type": "condition",
              "field": "financialItemId",
              "operator": "==",
              "value": {
                "kind": "field",
                "source": "current",
                "path": "id"
              }
            },
            {
              "type": "condition",
              "field": "date",
              "operator": "==",
              "value": {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "field",
                    "source": "loaded",
                    "alias": "periodStatement",
                    "path": "periodEnd"
                  },
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "__extracted.fields.statementDate"
                  }
                ]
              }
            }
          ]
        },
        "data": {
          "financialItemId": {
            "kind": "field",
            "source": "current",
            "path": "id"
          },
          "date": {
            "kind": "call",
            "fn": "coalesce",
            "args": [
              {
                "kind": "field",
                "source": "loaded",
                "alias": "periodStatement",
                "path": "periodEnd"
              },
              {
                "kind": "field",
                "source": "current",
                "path": "__extracted.fields.statementDate"
              }
            ]
          },
          "balance": {
            "kind": "field",
            "source": "loaded",
            "alias": "periodStatement",
            "path": "closingBalance"
          },
          "statementId": {
            "kind": "field",
            "source": "loaded",
            "alias": "periodStatement",
            "path": "id"
          }
        },
        "as": "statementSnapshot"
      },
      {
        "type": "updateMatching",
        "entity": "financialItem",
        "where": {
          "type": "condition",
          "field": "id",
          "operator": "==",
          "value": {
            "kind": "field",
            "source": "current",
            "path": "id"
          }
        },
        "set": {
          "currentBalance": {
            "kind": "field",
            "source": "loaded",
            "alias": "periodStatement",
            "path": "closingBalance"
          }
        }
      }
    ],
    "enabled": true,
    "order": 0,
    "chainHooks": false
  }
}
