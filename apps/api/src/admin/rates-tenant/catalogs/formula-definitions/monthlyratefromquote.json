{
  "kind": "formula-definition",
  "version": 1,
  "data": {
    "name": "monthlyRateFromQuote",
    "description": "Convert quoted bank rate (EA/NA/NMV) to monthly decimal",
    "inputs": [
      {
        "name": "rate",
        "required": true,
        "description": "Interest rate (decimal)"
      },
      {
        "name": "quote",
        "required": true,
        "description": "Rate quote type: EA, NA, or NMV"
      }
    ],
    "body": {
      "kind": "switch",
      "input": {
        "kind": "call",
        "fn": "coalesce",
        "args": [
          {
            "kind": "input",
            "name": "quote"
          },
          {
            "kind": "literal",
            "value": "EA"
          }
        ]
      },
      "cases": [
        {
          "when": {
            "kind": "literal",
            "value": "NMV"
          },
          "then": {
            "kind": "binary",
            "op": "/",
            "left": {
              "kind": "call",
              "fn": "coalesce",
              "args": [
                {
                  "kind": "input",
                  "name": "rate"
                },
                {
                  "kind": "literal",
                  "value": 0
                }
              ]
            },
            "right": {
              "kind": "literal",
              "value": 100
            }
          }
        },
        {
          "when": {
            "kind": "literal",
            "value": "NA"
          },
          "then": {
            "kind": "binary",
            "op": "/",
            "left": {
              "kind": "binary",
              "op": "/",
              "left": {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "input",
                    "name": "rate"
                  },
                  {
                    "kind": "literal",
                    "value": 0
                  }
                ]
              },
              "right": {
                "kind": "literal",
                "value": 100
              }
            },
            "right": {
              "kind": "literal",
              "value": 12
            }
          }
        }
      ],
      "default": {
        "kind": "binary",
        "op": "-",
        "left": {
          "kind": "call",
          "fn": "pow",
          "args": [
            {
              "kind": "binary",
              "op": "+",
              "left": {
                "kind": "literal",
                "value": 1
              },
              "right": {
                "kind": "binary",
                "op": "/",
                "left": {
                  "kind": "call",
                  "fn": "coalesce",
                  "args": [
                    {
                      "kind": "input",
                      "name": "rate"
                    },
                    {
                      "kind": "literal",
                      "value": 0
                    }
                  ]
                },
                "right": {
                  "kind": "literal",
                  "value": 100
                }
              }
            },
            {
              "kind": "literal",
              "value": 0.08333333333333333
            }
          ]
        },
        "right": {
          "kind": "literal",
          "value": 1
        }
      }
    },
    "enabled": true,
    "source": "tenant"
  }
}
