            "args": [
              {
                "kind": "literal",
                "value": 1
              },
              {
                "kind": "formula",
                "name": "loanTermMonths",
                "inputs": {}
              }
            ]
          }
        }
      ],
      "default": {
        "kind": "formula",
        "name": "paymentScheduleFrenchRowCount",
        "inputs": {}
      }
    },
    "enabled": true,
    "source": "tenant"
  }
