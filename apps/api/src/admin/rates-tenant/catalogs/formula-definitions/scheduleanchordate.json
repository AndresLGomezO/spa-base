{
  "kind": "formula-definition",
  "version": 1,
  "data": {
    "name": "scheduleAnchorDate",
    "description": "Prefer nextDueDate when set (mid-loan / after payment); otherwise originationDate",
    "inputs": [
      {
        "name": "originationDate",
        "required": false,
        "description": "Loan origination date (ISO string)"
      },
      {
        "name": "nextDueDate",
        "required": false,
        "description": "Next payment due date (ISO string)"
      }
    ],
    "body": {
      "kind": "call",
      "fn": "if",
      "args": [
        {
          "kind": "unary",
          "op": "!",
          "operand": {
            "kind": "call",
            "fn": "isEmpty",
            "args": [
              {
                "kind": "input",
                "name": "nextDueDate"
              }
            ]
          }
        },
        {
          "kind": "input",
          "name": "nextDueDate"
        },
        {
          "kind": "input",
          "name": "originationDate"
        }
      ]
    },
    "enabled": true,
    "source": "tenant"
  }
}
