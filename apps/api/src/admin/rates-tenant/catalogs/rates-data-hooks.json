    {
      "name": "Default active status",
      "description": "FI-01: Set status ACTIVE on new financial items.",
      "entity": "financialItem",
      "phase": "before",
      "trigger": { "operation": "create" },
      "condition": null,
      "actions": [
        {
          "type": "setField",
          "field": "status",
          "value": { "kind": "literal", "value": "ACTIVE" }
        }
      ],
      "enabled": true,
      "order": 0
    },
    {
      "name": "Derive balance sheet role",
      "description": "FI-02: Set balanceSheetRole from itemType (debt → LIABILITY, investment types → ASSET, else NONE).",
      "entity": "financialItem",
      "phase": "before",
      "trigger": { "operation": "create" },
      "condition": null,
      "actions": [
        {
          "type": "setField",
          "field": "balanceSheetRole",
          "value": {
            "kind": "call",
            "fn": "if",
            "args": [
              {
                "kind": "binary",
                "op": "==",
                "left": { "kind": "field", "source": "current", "path": "itemType" },
                "right": { "kind": "literal", "value": "MORTGAGE" }
              },
              { "kind": "literal", "value": "LIABILITY" },
              {
                "kind": "call",
                "fn": "if",
                "args": [
                  {
                    "kind": "binary",
                    "op": "==",
                    "left": { "kind": "field", "source": "current", "path": "itemType" },
                    "right": { "kind": "literal", "value": "LOAN" }
                  },
                  { "kind": "literal", "value": "LIABILITY" },
                  {
                    "kind": "call",
                    "fn": "if",
                    "args": [
                      {
                        "kind": "binary",
                        "op": "==",
                        "left": { "kind": "field", "source": "current", "path": "itemType" },
                        "right": { "kind": "literal", "value": "CREDIT_CARD" }
                      },
                      { "kind": "literal", "value": "LIABILITY" },
                      {
                        "kind": "call",
                        "fn": "if",
                        "args": [
                          {
                            "kind": "binary",
                            "op": "==",
                            "left": { "kind": "field", "source": "current", "path": "itemType" },
                            "right": { "kind": "literal", "value": "REVOLVING_CREDIT" }
                          },
                          { "kind": "literal", "value": "LIABILITY" },
                          {
                            "kind": "call",
                            "fn": "if",
                            "args": [
                              {
                                "kind": "binary",
                                "op": "==",
                                "left": { "kind": "field", "source": "current", "path": "itemType" },
                                "right": { "kind": "literal", "value": "PERSONAL_DEBT" }
                              },
                              { "kind": "literal", "value": "LIABILITY" },
                              {
                                "kind": "call",
                                "fn": "if",
                                "args": [
                                  {
                                    "kind": "binary",
                                    "op": "==",
                                    "left": { "kind": "field", "source": "current", "path": "itemType" },
                                    "right": { "kind": "literal", "value": "SCHEDULED_SAVINGS" }
                                  },
                                  { "kind": "literal", "value": "ASSET" },
                                  {
                                    "kind": "call",
                                    "fn": "if",
                                    "args": [
                                      {
                                        "kind": "binary",
                                        "op": "==",
                                        "left": { "kind": "field", "source": "current", "path": "itemType" },
                                        "right": { "kind": "literal", "value": "YIELD_SAVINGS" }
                                      },
                                      { "kind": "literal", "value": "ASSET" },
                                      {
                                        "kind": "call",
                                        "fn": "if",
                                        "args": [
                                          {
                                            "kind": "binary",
                                            "op": "==",
                                            "left": { "kind": "field", "source": "current", "path": "itemType" },
                                            "right": { "kind": "literal", "value": "FIDUCIARY" }
                                          },
                                          { "kind": "literal", "value": "ASSET" },
                                          {
                                            "kind": "call",
                                            "fn": "if",
                                            "args": [
                                              {
                                                "kind": "binary",
                                                "op": "==",
                                                "left": { "kind": "field", "source": "current", "path": "itemType" },
                                                "right": { "kind": "literal", "value": "INVESTMENT_FUND" }
                                              },
                                              { "kind": "literal", "value": "ASSET" },
                                              {
                                                "kind": "call",
                                                "fn": "if",
                                                "args": [
                                                  {
                                                    "kind": "binary",
                                                    "op": "==",
                                                    "left": { "kind": "field", "source": "current", "path": "itemType" },
                                                    "right": { "kind": "literal", "value": "OTHER_INVESTMENT" }
                                                  },
                                                  { "kind": "literal", "value": "ASSET" },
                                                  { "kind": "literal", "value": "NONE" }
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "enabled": true,
      "order": 1
    },
