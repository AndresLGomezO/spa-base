    {
      "name": "Create initial schedule row",
      "description": "FI-03: Create one UPCOMING paymentSchedule row from nextDueDate and amount.",
      "entity": "financialItem",
      "phase": "after",
      "trigger": { "operation": "create" },
      "condition": {
        "type": "group",
        "combinator": "and",
        "children": [
          {
            "type": "condition",
            "field": "amount",
            "operator": ">",
            "value": { "kind": "literal", "value": 0 }
          },
          {
            "type": "condition",
            "field": "nextDueDate",
            "operator": "isNotEmpty"
          }
        ]
      },
      "actions": [
        {
          "type": "createRecord",
          "entity": "paymentSchedule",
          "data": {
            "financialItemId": {
              "kind": "field",
              "source": "current",
              "path": "id"
            },
            "dueDate": {
              "kind": "field",
              "source": "current",
              "path": "nextDueDate"
            },
            "expectedAmount": {
              "kind": "field",
              "source": "current",
              "path": "amount"
            },
            "status": { "kind": "literal", "value": "UPCOMING" }
          }
        }
      ],
      "enabled": true,
      "order": 0
    },
    {
      "name": "Mark schedule PAID",
      "description": "TX-01: When a transaction links paymentScheduleId, mark that schedule PAID.",
      "entity": "transaction",
      "phase": "after",
      "trigger": { "operation": "create" },
      "chainHooks": true,
      "condition": {
        "type": "condition",
        "field": "paymentScheduleId",
        "operator": "isNotEmpty"
      },
      "actions": [
        {
          "type": "updateMatching",
          "entity": "paymentSchedule",
          "where": {
            "field": "id",
            "operator": "==",
            "value": {
              "kind": "field",
              "source": "current",
              "path": "paymentScheduleId"
            }
          },
          "set": {
            "status": { "kind": "literal", "value": "PAID" },
            "paidTransactionId": {
              "kind": "field",
              "source": "previous",
              "path": "id"
            }
          }
        }
      ],
      "enabled": true,
      "order": 0
    },
    {
      "name": "Update item balance on payment",
      "description": "TX-03: Decrease financialItem.currentBalance when type is PAYMENT.",
      "entity": "transaction",
      "phase": "after",
      "trigger": { "operation": "create" },
      "condition": {
        "type": "group",
        "combinator": "and",
        "children": [
          {
            "type": "condition",
            "field": "type",
            "operator": "==",
            "value": { "kind": "literal", "value": "PAYMENT" }
          },
          {
            "type": "condition",
            "field": "financialItemId",
            "operator": "isNotEmpty"
          }
        ]
      },
      "actions": [
        {
          "type": "updateMatching",
          "entity": "financialItem",
          "where": {
            "field": "id",
            "operator": "==",
            "value": {
              "kind": "field",
              "source": "current",
              "path": "financialItemId"
            }
          },
          "set": {
            "currentBalance": {
              "kind": "binary",
              "op": "-",
              "left": {
                "kind": "call",
                "fn": "coalesce",
                "args": [
                  {
                    "kind": "field",
                    "source": "current",
                    "path": "currentBalance"
                  },
                  { "kind": "literal", "value": 0 }
                ]
              },
              "right": {
                "kind": "field",
                "source": "previous",
                "path": "amount"
              }
            }
          }
        }
      ],
      "enabled": true,
      "order": 1
    },
