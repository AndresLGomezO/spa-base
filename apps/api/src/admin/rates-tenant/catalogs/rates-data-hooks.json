    {
      "name": "Default active status",
      "description": "FI-01: Set status ACTIVE on new financial items.",
      "entity": "financialItem",
      "phase": "before",
      "trigger": { "operation": "create" },
      "condition": null,
      "actions": [
        {
          "type": "setField",
          "field": "status",
          "value": { "kind": "literal", "value": "ACTIVE" }
        }
      ],
      "enabled": true,
      "order": 0
    },
    {
      "name": "Set liability balance sheet role",
      "description": "FI-02: Debt itemTypes → balanceSheetRole LIABILITY.",
      "entity": "financialItem",
      "phase": "before",
      "trigger": { "operation": "create" },
      "condition": {
        "type": "group",
        "combinator": "or",
        "children": [
          {
            "type": "condition",
            "field": "itemType",
            "operator": "==",
            "value": { "kind": "literal", "value": "MORTGAGE" }
          },
          {
            "type": "condition",
            "field": "itemType",
            "operator": "==",
            "value": { "kind": "literal", "value": "LOAN" }
          },
          {
            "type": "condition",
            "field": "itemType",
            "operator": "==",
            "value": { "kind": "literal", "value": "CREDIT_CARD" }
          },
          {
            "type": "condition",
            "field": "itemType",
            "operator": "==",
            "value": { "kind": "literal", "value": "REVOLVING_CREDIT" }
          },
          {
            "type": "condition",
            "field": "itemType",
            "operator": "==",
            "value": { "kind": "literal", "value": "PERSONAL_DEBT" }
          }
        ]
      },
      "actions": [
        {
          "type": "setField",
          "field": "balanceSheetRole",
          "value": { "kind": "literal", "value": "LIABILITY" }
        }
      ],
      "enabled": true,
      "order": 1
    },
