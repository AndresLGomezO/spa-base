{
  "kind": "chart-definitions-catalog",
  "version": 1,
  "chartDefinitions": [
    {
      "name": "Top category expense trend chart",
      "chartType": "area",
      "status": "ACTIVE",
      "displayMode": "overlay",
      "dataSource": {
        "type": "entityQuery",
        "entityQueryDefinitionId": "Category transaction trend",
        "xFieldPath": "date",
        "yFieldPath": "amount",
        "timeSeries": {
          "periodParameter": "period",
          "bucketCount": 30,
          "layout": "monthToDateRightAligned",
          "step": {
            "unit": "day",
            "offsetStart": 0,
            "offsetEnd": 0
          },
          "aggregate": "sum"
        }
      },
      "series": [
        {
          "id": "default",
          "label": "Category expenses",
          "color": "var(--color-chart-glow-2)",
          "showAreaFill": true,
          "areaFillColor": "var(--color-chart-glow-2)",
          "areaFillOpacity": 0.18,
          "strokeWidth": 2
        }
      ],
      "xAxis": {
        "visible": false,
        "showTicks": false
      },
      "yAxis": {
        "visible": false,
        "showTicks": false
      },
      "legend": {
        "visible": false,
        "position": "none"
      },
      "grid": {
        "visible": false
      },
      "animation": {
        "enabled": true,
        "durationMs": 600
      }
    }
  ]
}
