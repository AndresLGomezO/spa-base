      "name": "Income by Month",
      "description": "Sum of income transactions bucketed by calendar month on date.",
      "sourceModel": "transaction",
      "aggregations": [
        {
          "operation": "SUM",
          "field": "amount"
        }
      ],
      "filters": [
        {
          "field": "type",
          "op": "eq",
          "value": "INCOME"
        }
      ],
      "groupBy": [],
