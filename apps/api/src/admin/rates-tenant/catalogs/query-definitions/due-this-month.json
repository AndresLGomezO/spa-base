{
  "kind": "entity-query-definition",
  "version": 1,
  "data": {
    "name": "Due this month",
    "sourceEntity": "paymentSchedule",
    "filter": {
      "type": "group",
      "combinator": "and",
      "children": [
        {
          "type": "condition",
          "field": "status",
          "operator": "in",
          "value": {
            "type": "static",
            "value": [
              "UPCOMING",
              "OVERDUE"
            ]
          }
        },
        {
          "type": "condition",
          "field": "dueDate",
          "operator": ">=",
          "value": {
            "type": "parameter",
            "name": "period",
            "bound": "start"
          }
        },
        {
          "type": "condition",
          "field": "dueDate",
          "operator": "<=",
          "value": {
            "type": "parameter",
            "name": "period",
            "bound": "end"
          }
        }
      ]
    },
    "sort": [
      {
        "field": "dueDate",
        "direction": "asc"
      }
    ],
    "limitMode": "topN",
    "limit": 100,
    "status": "ACTIVE",
    "parameters": [
      {
        "name": "period",
        "valueType": "dateBucket",
        "granularity": "month",
        "field": "dueDate"
      }
    ]
  }
}
