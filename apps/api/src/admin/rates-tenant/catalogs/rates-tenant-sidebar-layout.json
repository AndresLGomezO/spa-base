              {
                "type": "component",
                "id": "sidebar-footer",
                "component": {
                  "kind": "container",
                  "rows": [
                    {
                      "type": "component",
                      "id": "sidebar-notification-bell",
                      "component": {
                        "kind": "notification-bell",
                        "iconName": "Bell",
                        "showBadge": true
