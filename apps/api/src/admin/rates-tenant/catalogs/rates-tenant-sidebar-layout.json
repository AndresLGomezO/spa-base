{
  "kind": "tenant-sidebar-layout-catalog",
  "version": 1,
  "description": "Rates app shell — platform-default sidebar/header plus mobile floating footer nav.",
  "sidebarLayout": {
    "root": {
      "type": "screen-root",
      "id": "sidebar-screen",
      "gridTemplateColumns": "1fr",
      "rows": [
        {
          "type": "component",
          "id": "sidebar-shell",
          "component": {
            "kind": "container",
            "rows": [
              {
                "type": "component",
                "id": "sidebar-header",
                "component": {
                  "kind": "container",
                  "rows": [
                    {
                      "type": "component",
                      "id": "sidebar-logo",
                      "component": {
                        "primary": {
                          "type": "static",
                          "value": ""
                        },
                        "kind": "image",
                        "imageSize": 32
                      },
                      "name": "Logo"
                    },
                    {
                      "type": "component",
                      "id": "sidebar-collapse",
                      "component": {
                        "kind": "sidebar-collapse",
                        "iconName": "PanelLeftClose",
                        "expandIconName": "PanelLeft",
                        "styles": [
                          {
                            "property": "marginLeft",
