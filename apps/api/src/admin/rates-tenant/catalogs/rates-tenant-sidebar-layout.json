                    "rows": [
                      {
                        "type": "component",
                        "id": "sidebar-group-icon",
                        "component": {
                          "kind": "icon",
                          "iconName": "Folder",
                          "iconSize": 16
                        }
                      },
                      {
                        "type": "component",
                        "id": "sidebar-group-label",
                        "component": {
                          "primary": {
                            "type": "static",
                            "value": "Item"
                          },
                          "kind": "text"
                        }
                      }
                    ]
                  },
                  "subgroupItem": {
                    "rows": [
                      {
                        "type": "component",
                        "id": "sidebar-subgroup-icon",
                        "component": {
                          "kind": "icon",
                          "iconName": "FolderOpen",
                          "iconSize": 16
                        }
                      },
                      {
                        "type": "component",
                        "id": "sidebar-subgroup-label",
                        "component": {
                          "primary": {
                            "type": "static",
                            "value": "Item"
