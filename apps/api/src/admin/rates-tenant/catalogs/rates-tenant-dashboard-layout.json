{
  "kind": "tenant-dashboard-layout-catalog",
  "version": 1,
  "description": "Rates test tenant home dashboard — search/filters toolbar, account metric widgets in one grid row.",
  "dashboardLayout": {
    "root": {
      "type": "screen-root",
      "id": "dashboard-screen",
      "gridTemplateColumns": "1fr",
      "gap": "24px",
      "styles": [
        {
          "property": "padding",
          "value": "var(--spacing-macro)"
        }
      ],
      "rows": [
        {
          "type": "component",
          "id": "track-dashboard-toolbar",
          "component": {
            "kind": "container",
            "rows": [
              {
                "type": "component",
                "id": "row-dashboard-view-filter",
                "component": {
                  "kind": "view-filter",
                  "enableSearch": true,
                  "enableFilters": true,
                  "enableDateFilter": true,
                  "dateFilterGranularity": "month",
                  "dateFilterParam": "month",
                  "searchPlaceholder": "Search accounts…",
                  "filters": [
                    {
                      "entityName": "account",
                      "fieldName": "accountType"
                    },
                    {
                      "entityName": "account",
                      "fieldName": "currency"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "component",
          "id": "track-account-metrics",
          "component": {
            "kind": "container",
            "rows": [
              {
                "type": "component",
                "id": "row-section-account-metrics",
                "component": {
                  "kind": "dashboard-section",
                  "sectionId": "account-metrics"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "dashboardSections": [
    {
      "id": "account-metrics",
      "name": "Account Metrics",
      "layout": {
        "root": {
          "type": "root",
          "id": "section-account-metrics-root",
          "columnCount": 1,
          "columns": [
            {
              "id": "col-account-metrics",
              "rows": [
                {
                  "type": "component",
                  "id": "row-aff84716-3078-45f4-898b-712583727be2",
                  "component": {
                    "kind": "container",
                    "rows": [
                      {
                        "type": "component",
                        "id": "row-account-metrics-grid",
                        "component": {
                          "kind": "grid",
                          "gridTemplateColumns": "minmax(400px, 450px) 1fr",
                          "gap": "15",
                          "alignItems": "stretch",
                          "rows": [
                            {
                              "type": "component",
                              "id": "track-total-balance-widget",
                              "component": {
                                "kind": "container",
                                "rows": [
                                  {
                                    "type": "component",
                                    "id": "row-total-balance-widget",
                                    "component": {
                                      "kind": "metric-widget",
                                      "entityName": "account",
                                      "widgetId": "total-balance-by-month",
                                      "styles": [
                                        {
                                          "property": "width",
                                          "value": "100%"
                                        },
                                        {
                                          "property": "height",
                                          "value": "100%"
                                        },
                                        {
                                          "property": "flex",
                                          "value": "1"
                                        }
                                      ]
                                    }
                                  }
                                ],
                                "stackDirection": "column",
