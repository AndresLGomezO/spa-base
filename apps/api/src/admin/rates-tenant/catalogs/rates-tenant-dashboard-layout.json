                                    "value": "100%"
                                  },
                                  {
                                    "property": "height",
                                    "value": "100%"
                                  },
                                  {
                                    "property": "minWidth",
                                    "value": "0"
                                  },
                                  {
                                    "property": "overflowX",
                                    "value": "hidden"
                                  },
                                  {
                                    "property": "overflowY",
                                    "value": "hidden"
                                  }
