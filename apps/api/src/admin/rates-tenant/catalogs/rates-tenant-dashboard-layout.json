{
  "kind": "tenant-dashboard-layout-catalog",
  "version": 1,
  "description": "Rates test tenant home dashboard — toolbar, account metrics, financial snapshot, and recent activity.",
  "dashboardLayout": {
    "root": {
      "type": "screen-root",
      "id": "dashboard-screen",
      "gridTemplateColumns": "1fr",
      "gap": "24px",
      "rows": [
        {
          "type": "component",
          "id": "row-f32cf5da-dca5-4a9d-8ca8-6cc6ac250fcd",
          "component": {
            "kind": "container",
            "rows": [
              {
                "type": "component",
                "id": "track-dashboard-toolbar",
                "component": {
                  "kind": "container",
                  "rows": [
                    {
                      "type": "component",
                      "id": "row-dashboard-view-filter",
                      "component": {
                        "kind": "view-filter",
                        "enableSearch": true,
                        "enableFilters": true,
                        "enableDateFilter": true,
                        "dateFilterGranularity": "month",
                        "dateFilterParam": "month",
                        "searchPlaceholder": "Search accounts…",
                        "filters": [
                          {
                            "entityName": "account",
                            "fieldName": "accountType"
                          },
                          {
                            "entityName": "account",
                            "fieldName": "currency"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "type": "component",
                "id": "track-account-metrics",
                "component": {
                  "kind": "container",
                  "rows": [
                    {
                      "type": "component",
                      "id": "row-section-account-metrics",
                      "component": {
                        "kind": "dashboard-section",
                        "sectionId": "account-metrics"
                      }
                    }
                  ]
                }
              },
              {
                "type": "component",
                "id": "track-financial-snapshot",
                "component": {
                  "kind": "container",
                  "rows": [
                    {
                      "type": "component",
                      "id": "row-section-financial-snapshot",
                      "component": {
                        "kind": "dashboard-section",
                        "sectionId": "financial-snapshot"
                      }
                    }
                  ]
                }
              },
              {
                "type": "component",
                "id": "track-recent-activity",
                "component": {
                  "kind": "container",
                  "rows": [
                    {
                      "type": "component",
                      "id": "row-section-recent-activity",
                      "component": {
                        "kind": "dashboard-section",
                        "sectionId": "recent-activity",
                        "label": "Recent Activity"
                      }
                    }
                  ]
                }
              }
            ],
            "styles": [
              {
                "property": "padding",
                "value": "var(--spacing-macro)"
              }
            ]
          }
        }
      ]
    }
  },
  "dashboardSections": [
    {
      "id": "account-metrics",
      "name": "Account Metrics",
      "layout": {
        "root": {
          "type": "root",
          "id": "section-account-metrics-root",
          "columnCount": 1,
          "columns": [
            {
              "id": "col-account-metrics",
              "rows": [
                {
                  "type": "component",
                  "id": "row-aff84716-3078-45f4-898b-712583727be2",
                  "component": {
                    "kind": "container",
                    "rows": [
                      {
                        "type": "component",
                        "id": "row-04d8d505-590f-42be-8c70-edb9246a5320",
                        "component": {
                          "kind": "metric-widget",
                          "entityName": "account",
                          "widgetId": "total-balance-by-month",
                          "styles": [
                            {
                              "property": "height",
                              "value": "100%"
                            },
                            {
                              "property": "maxWidth",
                              "value": "450"
                            },
                            {
                              "property": "minWidth",
                              "value": "300"
                            }
                          ]
                        }
                      },
                      {
                        "type": "component",
                        "id": "row-1b21a831-baa1-4c39-b9f5-4d87f2bafd25",
                        "component": {
                          "kind": "container",
                          "rows": [
                            {
                              "type": "component",
                              "id": "row-e1f09ffe-7f0f-4eef-b5d6-fecc162f5638",
                              "component": {
                                "kind": "metric-widget",
                                "entityName": "account",
                                "widgetId": "income-by-month",
                                "styles": [
                                  {
                                    "property": "height",
                                    "value": "100%"
                                  },
                                  {
                                    "property": "maxWidth",
                                    "value": "250"
                                  },
                                  {
                                    "property": "minWidth",
                                    "value": "110"
                                  }
                                ]
                              }
                            },
                            {
                              "type": "component",
                              "id": "row-56d63920-7247-46aa-be8e-c36fb425ad64",
                              "component": {
                                "kind": "metric-widget",
                                "entityName": "account",
                                "widgetId": "expenses-by-month",
                                "styles": [
                                  {
                                    "property": "height",
                                    "value": "100%"
                                  },
                                  {
                                    "property": "minWidth",
                                    "value": "110"
                                  },
                                  {
                                    "property": "maxWidth",
                                    "value": "250"
                                  }
                                ]
                              }
                            },
                            {
                              "type": "component",
                              "id": "row-fc8644ed-5f67-45d8-8b66-9ebcf1b75e33",
                              "component": {
                                "kind": "metric-widget",
                                "entityName": "account",
                                "widgetId": "invest-by-month",
                                "styles": [
                                  {
                                    "property": "height",
                                    "value": "100%"
                                  },
                                  {
                                    "property": "maxWidth",
                                    "value": "250"
                                  },
                                  {
                                    "property": "minWidth",
                                    "value": "110"
                                  }
                                ]
                              }
                            }
                          ],
                          "stackDirection": "row",
                          "styles": [
                            {
                              "property": "gap",
                              "value": "var(--spacing-compact)"
                            }
                          ]
                        }
                      }
                    ],
                    "stackDirection": "row",
                    "styles": [
                      {
                        "property": "gap",
                        "value": "var(--spacing-comfortable)"
                      },
                      {
                        "property": "flexWrap",
                        "value": "wrap"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
