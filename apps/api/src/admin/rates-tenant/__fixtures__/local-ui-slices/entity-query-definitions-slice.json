{
  "kind": "entity-query-definitions-catalog",
  "version": 1,
  "exportedAt": "2026-07-06T20:00:00.000Z",
  "description": "Local Rates tenant — dashboard queries for upcoming payments and mini-widget metrics.",
  "entityQueryDefinitions": [
    {
      "name": "Upcoming payments (dashboard)",
      "sourceEntity": "paymentSchedule",
      "filter": {
        "type": "group",
        "combinator": "and",
        "children": [
          {
            "type": "condition",
            "field": "status",
            "operator": "in",
            "value": {
              "type": "static",
              "value": ["UPCOMING", "OVERDUE"]
            }
          },
          {
            "type": "condition",
            "field": "financialItemId.flowKind",
            "operator": "!=",
            "value": {
              "type": "static",
              "value": "INCOME"
            }
          },
          {
            "type": "condition",
            "field": "dueDate",
            "operator": "<=",
            "value": {
              "type": "parameter",
              "name": "period",
              "bound": "end"
            }
          }
        ]
      },
      "sort": [
        {
          "field": "dueDate",
          "direction": "asc"
        }
      ],
      "limitMode": "all",
      "status": "ACTIVE",
      "parameters": [
        {
          "name": "period",
          "valueType": "dateBucket",
          "granularity": "month",
          "field": "dueDate"
        }
      ]
    },
    {
      "name": "Due today (metrics)",
      "sourceEntity": "paymentSchedule",
      "filter": {
        "type": "group",
        "combinator": "and",
        "children": [
          {
            "type": "condition",
            "field": "status",
            "operator": "in",
            "value": {
              "type": "static",
              "value": ["UPCOMING", "OVERDUE"]
            }
          },
          {
            "type": "condition",
            "field": "financialItemId.flowKind",
            "operator": "!=",
            "value": {
              "type": "static",
              "value": "INCOME"
            }
          },
          {
            "type": "condition",
            "field": "dueDate",
            "operator": ">=",
            "value": {
              "type": "temporal",
              "preset": "startOfDay"
            }
          },
          {
            "type": "condition",
            "field": "dueDate",
            "operator": "<=",
            "value": {
              "type": "temporal",
              "preset": "endOfDay"
            }
          }
        ]
      },
      "sort": [
        {
          "field": "dueDate",
          "direction": "asc"
        }
      ],
      "limitMode": "all",
      "status": "ACTIVE"
    },
    {
      "name": "Overdue payments (metrics)",
      "sourceEntity": "paymentSchedule",
      "filter": {
        "type": "group",
        "combinator": "and",
        "children": [
          {
            "type": "condition",
            "field": "status",
            "operator": "==",
            "value": {
              "type": "static",
              "value": "OVERDUE"
            }
          },
          {
            "type": "condition",
            "field": "financialItemId.flowKind",
            "operator": "!=",
            "value": {
              "type": "static",
              "value": "INCOME"
            }
          },
          {
            "type": "condition",
            "field": "dueDate",
            "operator": "<=",
            "value": {
              "type": "parameter",
              "name": "period",
              "bound": "end"
            }
          }
        ]
      },
      "sort": [
        {
          "field": "dueDate",
          "direction": "asc"
        }
      ],
      "limitMode": "all",
      "status": "ACTIVE",
      "parameters": [
        {
          "name": "period",
          "valueType": "dateBucket",
          "granularity": "month",
          "field": "dueDate"
        }
      ]
    },
    {
      "name": "Upcoming this week (metrics)",
      "sourceEntity": "paymentSchedule",
      "filter": {
        "type": "group",
        "combinator": "and",
        "children": [
          {
            "type": "condition",
            "field": "status",
            "operator": "==",
            "value": {
              "type": "static",
              "value": "UPCOMING"
            }
          },
          {
            "type": "condition",
            "field": "financialItemId.flowKind",
            "operator": "!=",
            "value": {
              "type": "static",
              "value": "INCOME"
            }
          },
          {
            "type": "condition",
            "field": "dueDate",
            "operator": ">=",
            "value": {
              "type": "temporal",
              "preset": "startOfWeek"
            }
          },
          {
            "type": "condition",
            "field": "dueDate",
            "operator": "<=",
            "value": {
              "type": "temporal",
              "preset": "endOfWeek"
            }
          }
        ]
      },
      "sort": [
        {
          "field": "dueDate",
          "direction": "asc"
        }
      ],
      "limitMode": "all",
      "status": "ACTIVE"
    }
  ]
}
