{
  "kind": "entity-query-definition",
  "version": 1,
  "data": {
    "name": "Upcoming this week (metrics)",
    "sourceEntity": "paymentSchedule",
    "filter": {
      "type": "group",
      "combinator": "and",
      "children": [
        {
          "type": "condition",
          "field": "status",
          "operator": "==",
          "value": {
            "type": "static",
            "value": "UPCOMING"
          }
        },
        {
          "type": "condition",
          "field": "financialItemId.flowKind",
          "operator": "!=",
          "value": {
            "type": "static",
            "value": "INCOME"
          }
        },
        {
          "type": "condition",
          "field": "dueDate",
          "operator": ">=",
          "value": {
            "type": "temporal",
            "preset": "startOfWeek"
          }
        },
        {
          "type": "condition",
          "field": "dueDate",
          "operator": "<=",
          "value": {
            "type": "temporal",
            "preset": "endOfWeek"
          }
        }
      ]
    },
    "sort": [
      {
        "field": "dueDate",
        "direction": "asc"
      }
    ],
    "limitMode": "all",
    "status": "ACTIVE"
  }
}
