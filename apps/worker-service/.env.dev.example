# AI integration mode (local Docker)
# Copy to .env.dev: cp apps/worker-service/.env.dev.example apps/worker-service/.env.dev
USE_REAL_VERTEX=false
GCP_PROJECT_ID=demo-project-base
GCP_REGION=us-central1
VERTEX_MODEL_ID=gemini-2.5-flash

# Real Vertex on a GCP project (keep GCP_PROJECT_ID on demo-project-base for emulators):
# VERTEX_GCP_PROJECT_ID=entitysystem-development
# USE_REAL_VERTEX=true
#   pnpm dev:docker:reset -- --only ai --use-real-vertex

# Mock Vertex (default):
#   pnpm dev:docker:reset -- --only ai --mock-vertex
