# AI integration mode (local Docker)
# Copy to .env.dev: cp apps/worker-service/.env.dev.example apps/worker-service/.env.dev
USE_REAL_VERTEX=false
GCP_PROJECT_ID=demo-project-base
GCP_REGION=us-central1
# Gemini 3.x preview models are global-only on Vertex (keep GCP_REGION regional for embeddings/Imagen).
VERTEX_LOCATION=global
VERTEX_MODEL_ID=gemini-3.6-flash
VERTEX_REASONING_MODEL_ID=gemini-3.1-pro-preview
VERTEX_IMAGEN_MODEL_ID=imagen-3.0-generate-002

# Storage emulator public host is set in docker-compose.dev.yml for worker-service:
# FIREBASE_STORAGE_EMULATOR_PUBLIC_HOST=127.0.0.1:9199

# Real Vertex on a GCP project (keep GCP_PROJECT_ID on demo-project-base for emulators):
# VERTEX_GCP_PROJECT_ID=entitysystem-development
# USE_REAL_VERTEX=true
#   pnpm dev:docker:reset -- --only ai --use-real-vertex

# Mock Vertex (default):
#   pnpm dev:docker:reset -- --only ai --mock-vertex

# Scheduled data hook ticks (required for categorize / overdue / etc.)
# Local demo user uid from seed: test_user_1
SCHEDULED_HOOK_USER_UID=test_user_1

# Gmail ingest (same OAuth client + encryption key as apps/api/.env.dev)
# Required for local Gmail ingest — without TENANT_ENCRYPTION_MASTER_KEY the worker
# does not register /tasks/gmail-* routes.
TENANT_ENCRYPTION_MASTER_KEY=
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_PUBSUB_TOPIC=
# GMAIL_INGEST_DELIVERY_MODE=poll
# Prefer Platform → Observability → Gmail ingest delivery at runtime (overrides this env).
# GMAIL_TASKS_QUEUE_NAME=gmail-jobs
# GMAIL_TASKS_LOCAL_DISPATCH=true
# WORKER_SERVICE_URL=http://worker-service:3001

# Aggregation emit from hook writes (email ingest, data hooks, schedule)
# Docker compose sets PUBSUB=true + PUBSUB_EMULATOR_HOST. Host-only default is inline (false).
# AGGREGATION_EVENTS_PUBSUB=false
# AGGREGATION_EVENTS_TOPIC=aggregation-events

# Manual poll (when mode=poll; no Cloud Scheduler locally):
# curl -X POST http://127.0.0.1:3001/tasks/gmail-poll \
#   -H 'Content-Type: application/json' \
#   -H 'X-Local-Task-Dispatcher: true' -d '{}'
