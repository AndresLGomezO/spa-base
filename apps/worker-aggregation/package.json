    "@repo/firestore-converters": "workspace:*",
    "@repo/gcp-firebase": "workspace:*",
    "@repo/metrics-engine": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/esbuild-runtime-deps": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
